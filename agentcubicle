#!/bin/bash
# Run opencode or claude in an isolated container (Docker or rootless Podman),
# starting in a read-only plan mode you manually escalate out of. Project files
# are mounted read-write. The engine is auto-detected (Podman preferred when
# both are installed); set AGENTCUBICLE_ENGINE=docker or =podman to override.
#
# Usage:
#   agentcubicle setup [--clear] [--claude]               # Build base image; --claude adds Claude Code
#   agentcubicle check [--img IMAGE]                     # Inspect image for required tools
#   agentcubicle list [--name NAME]                      # List containers
#   agentcubicle shell [--name NAME]                     # Shell into running container
#   agentcubicle commit [--name NAME]                     # Commit running container
#   agentcubicle cleanup                                  # Remove stopped containers
#   agentcubicle <opencode|claude> [--mount MOUNT] [--env ENV] [--img IMAGE] [--name NAME] [--] [tool args...]
#
# Examples:
#   agentcubicle list
#   agentcubicle shell
#   agentcubicle shell --name ac-myproject-abc123
#   agentcubicle setup
#   agentcubicle setup --claude
#   agentcubicle setup --clear
#   agentcubicle check
#   agentcubicle commit
#   agentcubicle commit --name ac-myproject-abc123
#   agentcubicle cleanup
#   agentcubicle opencode
#   agentcubicle claude
#   agentcubicle opencode --name my-session
#   agentcubicle claude --env ANTHROPIC_API_KEY="$(cat ~/.claude-key)"
#   agentcubicle opencode --mount /etc/ssh:/etc/ssh:ro
#   agentcubicle claude -- --model sonnet

set -euo pipefail

WORKDIR="$(pwd)"
CONTAINER_PROJECT_DIR="/home/user/project"
COMMIT_TARGET="agentcubicle"
EXTRA_MOUNTS=()
EXTRA_ENVS=()
EXTRA_ARGS=()
PARSE_DASHDASH=false
CLEAR=false
COMMAND=""
TOOL=""
CMD_NAME=""

# Container engine: honor AGENTCUBICLE_ENGINE if set, otherwise auto-detect,
# preferring podman when both are installed.
ENGINE="${AGENTCUBICLE_ENGINE:-}"
if [[ -n "$ENGINE" ]]; then
  if ! command -v "$ENGINE" >/dev/null 2>&1; then
    echo "Error: AGENTCUBICLE_ENGINE is set to '$ENGINE' but that command was not found." >&2
    exit 1
  fi
elif command -v podman >/dev/null 2>&1; then
  ENGINE=podman
elif command -v docker >/dev/null 2>&1; then
  ENGINE=docker
else
  echo "Error: no container engine found. Install podman or docker, or set AGENTCUBICLE_ENGINE." >&2
  exit 1
fi

# podman resolves unqualified image names against registries; pin the locally
# built image to an unambiguous localhost/ reference so build, FROM, run, and
# inspect all use the local image instead of attempting a registry pull.
if [[ "$ENGINE" == podman && "$COMMIT_TARGET" != */* ]]; then
  COMMIT_TARGET="localhost/$COMMIT_TARGET"
fi

# Packages and the binary to check for them. Format: "package:binary"
# If no colon, the binary has the same name as the package.
REQUIRED_PACKAGES=(
  "bat"
  "build-base:make"
  "cgdb"
  "curl"
  "curlie"
  "diffutils:diff"
  "file"
  "fzf"
  "gcc"
  "g++"
  "gdb"
  "gdb-dashboard:gdb"
  "git"
  "htop"
  "httpie"
  "jq"
  "lua5.4"
  "luajit"
  "lsof"
  "nano"
  "netcat-openbsd:nc"
  "nmap"
  "nodejs:node"
  "npm"
  "patch"
  "perl"
  "python3"
  "py3-pip:pip3"
  "shellcheck"
  "sqlite"
  "strace"
  "tcpdump"
  "tmux"
  "tree"
  "valgrind"
  "vim"
  "wl-clipboard:wl-copy"
  "wrk"
  "xclip"
)

# Resolve binary name for a package entry: "pkg:bin" → bin, "pkg" → pkg
_pkg_to_bin() {
  echo "${1#*:}"
}

# Default image for `check` and run
IMAGE="$COMMIT_TARGET"

# Generate unique container name: ac-<project>-<random>
_generate_name() {
  local sanitized
  sanitized="$(basename "$WORKDIR" | sed 's/[^a-zA-Z0-9_-]/-/g')"
  local rand
  rand="$(od -An -tx1 -N4 /dev/urandom | tr -d ' \n')"
  echo "ac-${sanitized}-${rand}"
}

# Determine config home directory based on tool
_config_home() {
  if [[ "$TOOL" == "opencode" ]]; then
    echo "$HOME/.config/opencode"
  else
    echo "$HOME/.claude"
  fi
}

# Write $2 to $1 only if that path does not exist yet, so local edits made
# in a previous run are never clobbered on the next one.
_seed_if_absent() {
  local target="$1"
  local content="$2"
  [[ -f "$target" ]] || printf '%s\n' "$content" > "$target"
}

# --- Phase 1: extract top-level subcommands (no tool context) ---
if [[ $# -gt 0 ]]; then
  case "$1" in
    setup|check|commit|cleanup|list|shell)
      COMMAND="$1"
      shift
      ;;
  esac
fi

# Parse `setup` flags
if [[ "$COMMAND" == "setup" ]]; then
  while [[ $# -gt 0 ]]; do
    case $1 in
      --clear)
        CLEAR=true
        shift
        ;;
      --claude)
        EXTRA_ARGS+=("--claude")
        shift
        ;;
      *)
        echo "Error: unknown argument '$1' for setup."
        echo "Usage: agentcubicle setup [--clear] [--claude]"
        exit 1
        ;;
    esac
  done
fi

# Parse `check` flags
if [[ "$COMMAND" == "check" ]]; then
  while [[ $# -gt 0 ]]; do
    case $1 in
      --img)
        IMAGE="$2"
        shift 2
        ;;
      *)
        echo "Error: unknown argument '$1' for check."
        echo "Usage: agentcubicle check [--img IMAGE]"
        exit 1
        ;;
    esac
  done
fi

# Parse `commit` flags
if [[ "$COMMAND" == "commit" ]]; then
  while [[ $# -gt 0 ]]; do
    case $1 in
      --name)
        CMD_NAME="$2"
        shift 2
        ;;
      *)
        echo "Error: unknown argument '$1' for commit."
        echo "Usage: agentcubicle commit [--name NAME]"
        exit 1
        ;;
    esac
  done
fi

# Parse `list` flags
if [[ "$COMMAND" == "list" ]]; then
  while [[ $# -gt 0 ]]; do
    case $1 in
      --name)
        CMD_NAME="$2"
        shift 2
        ;;
      *)
        echo "Error: unknown argument '$1' for list."
        echo "Usage: agentcubicle list [--name NAME]"
        exit 1
        ;;
    esac
  done
fi

# Parse `shell` flags
if [[ "$COMMAND" == "shell" ]]; then
  while [[ $# -gt 0 ]]; do
    case $1 in
      --name)
        CMD_NAME="$2"
        shift 2
        ;;
      *)
        echo "Error: unknown argument '$1' for shell."
        echo "Usage: agentcubicle shell [--name NAME]"
        exit 1
        ;;
    esac
  done
fi

# --- Phase 2: run mode — requires <opencode|claude> ---
if [[ -z "$COMMAND" ]]; then
  if [[ $# -lt 1 ]] || [[ "$1" == "--" ]]; then
    echo "Error: First argument must be 'opencode' or 'claude'."
    echo ""
    echo "Usage: agentcubicle <opencode|claude> [options...] [--] [tool args...]"
    echo "       agentcubicle setup [--clear] [--claude]"
    echo "       agentcubicle check [--img IMAGE]"
    echo "       agentcubicle list [--name NAME]"
    echo "       agentcubicle shell [--name NAME]"
    echo "       agentcubicle commit [--name NAME]"
    echo "       agentcubicle cleanup"
    exit 1
  fi

  TOOL="$1"
  shift

  if [[ "$TOOL" != "opencode" && "$TOOL" != "claude" ]]; then
    echo "Error: Unknown tool '$TOOL'. Must be 'opencode' or 'claude'."
    exit 1
  fi

  # Parse remaining arguments for run
  while [[ $# -gt 0 ]]; do
    if $PARSE_DASHDASH; then
      EXTRA_ARGS+=("$1")
      shift
      continue
    fi

    case $1 in
      --name)
        CMD_NAME="$2"
        shift 2
        ;;
      --img)
        IMAGE="$2"
        shift 2
        ;;
      --mount)
        EXTRA_MOUNTS+=("-v" "$2")
        shift 2
        ;;
      --env)
        EXTRA_ENVS+=("-e" "$2")
        shift 2
        ;;
      --)
        PARSE_DASHDASH=true
        shift
        ;;
      *)
        EXTRA_ARGS+=("$1")
        shift
        ;;
    esac
  done
fi

# --- subcommand handlers ---

# -- setup: build custom image with dev tools and clipboard --
if [[ "$COMMAND" == "setup" ]]; then
  INSTALL_CLAUDE=false
  for arg in "${EXTRA_ARGS[@]+"${EXTRA_ARGS[@]}"}"; do
    if [[ "$arg" == "--claude" ]]; then
      INSTALL_CLAUDE=true
    fi
  done

  # Remove existing image first if --clear is set
  if $CLEAR; then
    $ENGINE image rm -f "$COMMIT_TARGET" >/dev/null 2>/dev/null || true
  fi

  NO_CACHE_ARGS=()
  if $CLEAR; then
    NO_CACHE_ARGS=(--no-cache)
  fi

  NEEDS_BASE=false
  NEEDS_CLAUDE=false
  HAS_CLAUDE=false

  if $ENGINE image inspect "$COMMIT_TARGET" >/dev/null 2>&1; then
    if $ENGINE run --entrypoint sh --rm "$COMMIT_TARGET" -c "test -x /home/user/.local/bin/claude" 2>/dev/null; then
      HAS_CLAUDE=true
    fi

    if $INSTALL_CLAUDE && ! $HAS_CLAUDE; then
      NEEDS_CLAUDE=true
    elif ! $INSTALL_CLAUDE; then
      echo "Image $COMMIT_TARGET is ready."
      if $HAS_CLAUDE; then
        echo "Claude Code is also installed."
      fi
      exit 0
    fi
  else
    NEEDS_BASE=true
  fi

  PKG_NAMES=()
  for entry in "${REQUIRED_PACKAGES[@]}"; do
    PKG_NAMES+=("${entry%%:*}")
  done

  # Build base + optionally claude in one go
  BUILD_CLAUDE=false
  if $NEEDS_BASE && $INSTALL_CLAUDE; then
    BUILD_CLAUDE=true
  fi

  if $NEEDS_BASE; then
    echo "Building $COMMIT_TARGET with dev tools ..."
    $ENGINE build ${NO_CACHE_ARGS[@]+"${NO_CACHE_ARGS[@]}"} --build-arg PACKAGES="${PKG_NAMES[*]}" --build-arg INSTALL_CLAUDE="$BUILD_CLAUDE" -t "$COMMIT_TARGET" - < <(
      cat <<'EOF'
FROM ghcr.io/anomalyco/opencode
ARG PACKAGES
ARG INSTALL_CLAUDE
RUN apk add --no-cache $PACKAGES bash libgcc libstdc++ ripgrep shadow
RUN addgroup -g 1000 user 2>/dev/null || true
RUN adduser -u 1000 -G user -D -h /home/user user 2>/dev/null || true
RUN mkdir -p /usr/local/bin
ENV PATH="/usr/local/bin:$PATH"
ENV USE_BUILTIN_RIPGREP=0
RUN if [ "$INSTALL_CLAUDE" = "true" ]; then su -s /bin/sh user -c 'export PATH="/home/user/.local/bin:$PATH" USE_BUILTIN_RIPGREP=0; curl -fsSL https://claude.ai/install.sh | bash'; fi
EOF
    )
    echo "Done. Image '$COMMIT_TARGET' is ready."
  fi

  # If image existed but lacks claude, add it on top
  if $NEEDS_CLAUDE; then
    echo "Adding claude to $COMMIT_TARGET ..."
    $ENGINE build ${NO_CACHE_ARGS[@]+"${NO_CACHE_ARGS[@]}"} -t "$COMMIT_TARGET" - < <(
       cat <<EOF
FROM $COMMIT_TARGET
RUN apk add --no-cache shadow
RUN addgroup -g 1000 user 2>/dev/null || true; adduser -u 1000 -G user -D -h /home/user user 2>/dev/null || true
RUN mkdir -p /usr/local/bin
ENV PATH="/usr/local/bin:\$PATH"
ENV USE_BUILTIN_RIPGREP=0
RUN su -s /bin/sh user -c 'export PATH="/home/user/.local/bin:\$PATH" USE_BUILTIN_RIPGREP=0; curl -fsSL https://claude.ai/install.sh | bash'
EOF
    )
    echo "Done. Claude Code is installed."
  else
    echo "Image $COMMIT_TARGET is ready."
    if $HAS_CLAUDE; then
      echo "Claude Code is already installed."
    fi
  fi

  exit 0
fi

# -- check: inspect image for required tools --
if [[ "$COMMAND" == "check" ]]; then
  # A --img override may be unqualified; pin it to localhost/ under podman.
  if [[ "$ENGINE" == podman && "$IMAGE" != */* ]]; then
    IMAGE="localhost/$IMAGE"
  fi
  _ok() { echo "  ✓ $1"; }
  _missing() { echo "  ✗ $1 (missing)"; }

  echo "Checking image '$IMAGE' ..."
  MISSING=0

  for entry in "${REQUIRED_PACKAGES[@]}"; do
    PKG="${entry%%:*}"
    BIN="$(_pkg_to_bin "$entry")"
    if $ENGINE run --entrypoint sh --rm "$IMAGE" -c "command -v $BIN >/dev/null" 2>/dev/null; then
      _ok "$PKG"
    else
      _missing "$PKG"
      MISSING=1
    fi
  done

  # Also check for claude (installed to /home/user/.local/bin/claude)
  if $ENGINE run --entrypoint sh --rm "$IMAGE" -c "test -x /home/user/.local/bin/claude" 2>/dev/null; then
    _ok "claude"
  else
    _missing "claude"
    MISSING=1
  fi

  if [[ "$MISSING" -eq 1 ]]; then
    echo ""
    echo "Run 'agentcubicle setup' to install missing tools into $COMMIT_TARGET."
  fi
  exit 0
fi

# -- cleanup --
if [[ "$COMMAND" == "cleanup" ]]; then
  for cid in $($ENGINE ps -a --filter 'name=^ac-' --filter 'status=exited' --format '{{.ID}}' 2>/dev/null || true); do
    $ENGINE rm "$cid"
  done
  exit 0
fi

# -- list --
if [[ "$COMMAND" == "list" ]]; then
  if [[ -n "$CMD_NAME" ]]; then
    $ENGINE ps -a --filter "name=$CMD_NAME" --format 'table {{.Status}}\t{{.Names}}\t{{.Image}}\t{{.CreatedAt}}' 2>/dev/null || true
  else
    $ENGINE ps -a --filter 'name=^ac-' --format 'table {{.Status}}\t{{.Names}}\t{{.Image}}\t{{.CreatedAt}}' 2>/dev/null || true
  fi
  exit 0
fi

# -- shell --
if [[ "$COMMAND" == "shell" ]]; then
  if [[ -n "$CMD_NAME" ]]; then
    $ENGINE inspect "$CMD_NAME" >/dev/null 2>&1 || { echo "Error: container '$CMD_NAME' not found."; exit 1; }
    RUNNING=$($ENGINE inspect -f '{{.State.Running}}' "$CMD_NAME" 2>/dev/null || true)
    if [[ "$RUNNING" != "true" ]]; then
      echo "Error: container '$CMD_NAME' is not running. Use 'list' to see containers."
      exit 1
    fi
    $ENGINE exec -it "$CMD_NAME" sh
    exit 0
  fi

  CONTAINERS=$($ENGINE ps --filter 'name=^ac-' --format '{{.Names}}' 2>/dev/null || true)
  if [[ -z "$CONTAINERS" ]]; then
    echo "No running containers prefixed with 'ac-' found."
    exit 1
  fi

  echo "Running containers:"
  IDX=1
  NAMES=()
  while IFS= read -r name; do
    [[ -z "$name" ]] && continue
    NAMES+=("$name")
    echo "  ${IDX}) ${name}"
    IDX=$((IDX + 1))
  done <<< "$CONTAINERS"

  if [[ ! -t 0 ]]; then
    echo "Error: no tty available. Use --name to specify a container (not interactive)."
    exit 1
  fi

  echo -n "Pick a container [1]: "
  read -r REPLY_CHOICE
  CHOICE="${REPLY_CHOICE:-1}"

  if ! [[ "$CHOICE" =~ ^[0-9]+$ ]] || [[ "$CHOICE" -lt 1 || "$CHOICE" -gt "${#NAMES[@]}" ]]; then
    echo "Invalid choice."
    exit 1
  fi

  $ENGINE exec -it "${NAMES[$((CHOICE - 1))]}" sh
  exit 0
fi

# -- commit --
if [[ "$COMMAND" == "commit" ]]; then
  if [[ -n "$CMD_NAME" ]]; then
    $ENGINE commit "$CMD_NAME" "$COMMIT_TARGET"
    exit 0
  fi

  # List running ac-* containers
  CONTAINERS=$($ENGINE ps --filter 'name=^ac-' --format '{{.Names}}' 2>/dev/null || true)
  if [[ -z "$CONTAINERS" ]]; then
    echo "No running containers prefixed with 'ac-' found."
    exit 1
  fi

  echo "Running containers:"
  IDX=1
  NAMES=()
  while IFS= read -r name; do
    [[ -z "$name" ]] && continue
    NAMES+=("$name")
    echo "  ${IDX}) ${name}"
    IDX=$((IDX + 1))
  done <<< "$CONTAINERS"

  if [[ ! -t 0 ]]; then
    echo "Error: no tty available. Use --name to specify a container (not interactive)."
    exit 1
  fi

  echo -n "Pick a container [1]: "
  read -r REPLY_CHOICE
  CHOICE="${REPLY_CHOICE:-1}"

  if ! [[ "$CHOICE" =~ ^[0-9]+$ ]] || [[ "$CHOICE" -lt 1 || "$CHOICE" -gt "${#NAMES[@]}" ]]; then
    echo "Invalid choice."
    exit 1
  fi

  $ENGINE commit "${NAMES[$((CHOICE - 1))]}" "$COMMIT_TARGET"
  exit 0
fi

# --- Normal mode: start a container ---
# A --img override may be unqualified; pin it to localhost/ under podman too so
# run and inspect use the local image instead of a registry short-name lookup.
if [[ "$ENGINE" == podman && "$IMAGE" != */* ]]; then
  IMAGE="localhost/$IMAGE"
fi
if ! $ENGINE image inspect "$IMAGE" >/dev/null 2>&1; then
  echo "Error: $IMAGE image not found."
  if [[ "$IMAGE" == "$COMMIT_TARGET" ]]; then
    echo "Run 'agentcubicle setup' first."
  fi
  exit 1
fi

CONTAINER_NAME="${CMD_NAME:-$(_generate_name)}"

# Remove only if a name was explicitly provided (re-use same name)
if [[ -n "$CMD_NAME" ]]; then
  $ENGINE rm -f "$CONTAINER_NAME" 2>/dev/null || true
fi

CONFIG_HOME="$(_config_home)"
DOCKER_CONFIG_ROOT="${CONFIG_HOME#"$HOME"}"

# Auto-redact literal API keys from the host opencode config. If a
# provider's options.apiKey is a literal value (not a {env:...} or
# {file:...} reference), forward the real value into the container as a
# generated env var and feed the container a redacted copy of the config
# that references {env:NAME} instead — so the literal key never lands in
# the container's writable config copy (or a `docker commit` of it), and a
# user who keeps a literal key in their own config needn't hand-convert it
# to the {env:VAR} shape. Only attempted when jq can parse the file; a
# .jsonc with comments is left untouched for the plain mount+copy path.
OPENCODE_REDACTED_B64=""
OPENCODE_REDACTED_BASENAME=""
if [[ "$TOOL" == "opencode" ]]; then
  for cfg in "$CONFIG_HOME/opencode.json" "$CONFIG_HOME/opencode.jsonc"; do
    [[ -f "$cfg" ]] || continue
    jq -e . "$cfg" >/dev/null 2>&1 || break
    redacted="$(cat "$cfg")"
    while IFS= read -r prov; do
      [[ -z "$prov" ]] && continue
      var="AC_OPENCODE_$(printf '%s' "$prov" | tr '[:lower:]' '[:upper:]' | tr -c 'A-Z0-9' '_')_APIKEY"
      val="$(printf '%s' "$redacted" | jq -r --arg p "$prov" '.provider[$p].options.apiKey')"
      EXTRA_ENVS+=("-e" "$var=$val")
      redacted="$(printf '%s' "$redacted" | jq --arg p "$prov" --arg v "$var" '.provider[$p].options.apiKey = "{env:" + $v + "}"')"
    done < <(jq -r '.provider // {} | to_entries[]
                    | select((.value.options.apiKey? | type) == "string")
                    | select((.value.options.apiKey | test("^\\{(env|file):[^}]*\\}$")) | not)
                    | .key' "$cfg")
    if [[ "$redacted" != "$(cat "$cfg")" ]]; then
      OPENCODE_REDACTED_B64="$(printf '%s' "$redacted" | base64 -w0)"
      OPENCODE_REDACTED_BASENAME="$(basename "$cfg")"
    fi
    break
  done
fi

# For claude, mount only settings.json (the one file the entrypoint ever
# reads from here) rather than the whole ~/.claude directory, so the
# oauth-token file (and the raw .credentials.json) never enter the
# container's mount namespace at all - the oauth token is already forwarded
# separately as an env var below. Guarded on existence: bind-mounting a
# single file that does not yet exist on the host causes Docker to create
# an empty directory there instead, which would corrupt a future
# `claude setup-token` save.
CONFIG_HOME_MOUNT_ARGS=()
if [[ "$ENGINE" == podman ]]; then
  # podman runs as the unprivileged user, which cannot read /root, so config is
  # staged under a user-readable path for the entrypoint to copy into place.
  if [[ "$TOOL" == "claude" ]]; then
    if [[ -f "$CONFIG_HOME/settings.json" ]]; then
      CONFIG_HOME_MOUNT_ARGS=(-v "$CONFIG_HOME/settings.json:/home/user/.config-host/claude/settings.json:ro")
    fi
  elif [[ -z "$OPENCODE_REDACTED_B64" && -d "$CONFIG_HOME" ]]; then
    CONFIG_HOME_MOUNT_ARGS=(-v "$CONFIG_HOME:/home/user/.config-host/opencode:ro")
  fi
elif [[ "$TOOL" == "claude" ]]; then
  if [[ -f "$CONFIG_HOME/settings.json" ]]; then
    CONFIG_HOME_MOUNT_ARGS=(-v "$CONFIG_HOME/settings.json:/root/.claude/settings.json:ro")
  fi
elif [[ -z "$OPENCODE_REDACTED_B64" ]]; then
  # opencode without redaction: mount the host config dir read-only as the
  # copy source. When redaction applies, the config is injected via
  # OPENCODE_REDACTED_B64 instead, so the raw file (literal key and all)
  # never enters the container's mount namespace either.
  CONFIG_HOME_MOUNT_ARGS=(-v "$CONFIG_HOME:/root${DOCKER_CONFIG_ROOT}:ro")
fi

# Whether the host's opencode config defines any real providers, as
# opposed to relying solely on opencode's built-in free fallback models.
# Tries jq first (handles plain JSON correctly, including a present-but-
# empty "provider": {}); falls back to a flattened-then-grepped heuristic
# for .jsonc files with comments, which jq cannot parse.
OPENCODE_HAS_PROVIDER=false
if [[ "$TOOL" == "opencode" ]]; then
  for cfg in "$CONFIG_HOME/opencode.json" "$CONFIG_HOME/opencode.jsonc"; do
    [[ -f "$cfg" ]] || continue
    if PROVIDER_COUNT=$(jq -r '.provider // {} | length' "$cfg" 2>/dev/null); then
      [[ "$PROVIDER_COUNT" -gt 0 ]] && OPENCODE_HAS_PROVIDER=true
    elif tr -d '\n\r' < "$cfg" | grep -q '"provider"[[:space:]]*:[[:space:]]*{[[:space:]]*[^[:space:]}]'; then
      OPENCODE_HAS_PROVIDER=true
    fi
  done
fi

# Container-only opencode config override (never touches host config), sent
# via OPENCODE_CONFIG_CONTENT below. Two things live in it:
# - A blanket permission allow. Combined with --agent plan below, this makes
#   plan mode best-effort rather than a hard guarantee: opencode's own
#   plan-agent rules deny edits, but this blanket allow is appended after
#   them in the resolved rule list, so it can win. Accepted trade-off; see
#   README "Permissions" for detail.
# - An `instructions` entry pointing at the local AGENTS.local.md/MEMORY.local.md
#   pair (see the .agentcubicle/ block below) — confirmed empirically that
#   opencode merges `instructions` from OPENCODE_CONFIG_CONTENT with any
#   file-based config's own `instructions` array rather than replacing it,
#   so this is purely additive even when the project has its own AGENTS.md.
OPENCODE_CONFIG_JSON=$(jq -nc --arg dir "$CONTAINER_PROJECT_DIR" \
  '{"permission":{"*":"allow"},"instructions":[$dir + "/.agentcubicle/AGENTS.local.md", $dir + "/.agentcubicle/MEMORY.local.md"]}')

# Forward a safe, curated subset of the host's global git config (identity +
# a few UX settings) into the container. Allowlist, not blocklist, so we never
# have to guess what's dangerous: credential helpers, GPG/commit-signing keys,
# and any path-valued settings (core.excludesfile, core.hooksPath, ...) are
# simply never considered, since they'd either hang/fail (helpers, signing
# without a key) or require mounting host files outside the project directory.
GIT_ALLOWLIST=(user.name user.email init.defaultBranch pull.rebase push.default push.autoSetupRemote core.editor color.ui rerere.enabled merge.conflictstyle)
TMP_GITCONFIG="$(mktemp)"
for key in "${GIT_ALLOWLIST[@]}"; do
  val="$(git config --global --get "$key" 2>/dev/null || true)"
  [[ -n "$val" ]] && git config --file "$TMP_GITCONFIG" "$key" "$val"
done
# --null: NUL-separates each key/value record and preserves embedded
# newlines in the value literally (git's own default line-based output
# would truncate a multi-line shell-function alias at its first newline).
while IFS= read -r -d '' entry; do
  [[ -z "$entry" ]] && continue
  key="${entry%%$'\n'*}"
  val="${entry#*$'\n'}"
  git config --file "$TMP_GITCONFIG" "$key" "$val"
done < <(git config --global --get-regexp --null '^alias\.' 2>/dev/null || true)
HOST_GITCONFIG_B64=""
if [[ -s "$TMP_GITCONFIG" ]]; then
  HOST_GITCONFIG_B64="$(base64 -w0 < "$TMP_GITCONFIG")"
fi
rm -f "$TMP_GITCONFIG"

# Local, persistent, git-excluded agent rules + memory, read by both tools
# additively (even when the project already has its own tracked AGENTS.md/
# CLAUDE.md). Deliberately never placed at the literal AGENTS.md/CLAUDE.md
# paths: even a git-excluded symlink there is dangerous — if the upstream
# remote later adds a real tracked file at that exact path, git refuses to
# silently overwrite an existing untracked/excluded file during a merge or
# pull ("untracked working tree file would be overwritten"), so it would
# actively break the next `git pull`. `.git/info/exclude` only suppresses
# `git status`/`git add` discovery; it does not grant git permission to
# clobber a colliding path during merge.
#
# The files are suffixed `.local.md` (matching the CLAUDE.local.md root
# symlink) so they read unambiguously as agentcubicle-managed rather than
# colliding with a bare AGENTS.md/CLAUDE.md/MEMORY.md the project might track.
mkdir -p "$WORKDIR/.agentcubicle"

# One-time transition for projects seeded by an earlier version, which used
# the bare names. Auto-rename any legacy files to their .local.md counterpart:
# lossless, idempotent, and silent apart from a single notice. Runs before the
# seed step so seeding can't create fresh files next to orphaned legacy ones.
# Only moves when the new name is absent, so a hand-made .local.md is never
# clobbered.
_migrated=0
for _pair in "AGENTS.md:AGENTS.local.md" "CLAUDE.md:CLAUDE.local.md" "MEMORY.md:MEMORY.local.md"; do
  _old="$WORKDIR/.agentcubicle/${_pair%%:*}"
  _new="$WORKDIR/.agentcubicle/${_pair##*:}"
  if [[ -f "$_old" && ! -e "$_new" ]]; then
    mv "$_old" "$_new"
    _migrated=1
    # The CLAUDE file's `@` imports resolve relative to .agentcubicle/, so the
    # bare-name imports would now dangle — rewrite just those two directives
    # (any user prose is left untouched).
    if [[ "$_new" == */CLAUDE.local.md ]]; then
      sed -i -e 's/^@AGENTS\.md$/@AGENTS.local.md/' \
             -e 's/^@MEMORY\.md$/@MEMORY.local.md/' "$_new"
    fi
  fi
done
# Repoint the root symlink if it still targets the old CLAUDE.md; the creation
# guard further down only fires when nothing is present at the path, so it
# won't fix an existing symlink. Only our own symlink to the old target is
# touched — never a real file the user may have placed there.
if [[ -L "$WORKDIR/CLAUDE.local.md" && "$(readlink "$WORKDIR/CLAUDE.local.md")" == ".agentcubicle/CLAUDE.md" ]]; then
  ln -sfn .agentcubicle/CLAUDE.local.md "$WORKDIR/CLAUDE.local.md"
fi
[[ "$_migrated" == 1 ]] && echo "agentcubicle: migrated .agentcubicle/ files to the .local.md naming convention"

AGENTS_CONTENT=$(cat <<'AGENTS_EOF'
# AGENTS.local.md (agentcubicle local file)

> Local-only, machine-specific file maintained by `agentcubicle` at
> `.agentcubicle/AGENTS.local.md`, loaded automatically by whichever coding agent
> is running (mechanism varies by tool; see README.md if you are a human
> curious how) — *in addition to* any AGENTS.md the project itself already
> has, never as a replacement. Nothing here is ever committed, tracked, or
> shared with anyone who clones the repo.

## Rules

General, tool-agnostic agent rules and conventions for this project go
here. A few sensible defaults to start with:

- Never push to a remote, or suggest pushing (e.g. offering "push to
  origin" as a follow-up after a commit). This container's workflow is
  commit-only: pushing happens on the host, by the user, after
  reviewing what was committed.
- Prefer separate commits for logically distinct changes.
- When a local, non-shared file needs to be kept out of a repo's history,
  use `.git/info/exclude`, never `.gitignore` (a `.gitignore` entry is
  tracked and leaks your tooling choices to anyone who clones).
- No `Co-Authored-By` trailer is forced by the container — that's left as a
  host-side, user-level preference.

## Updating the rules

When updating agent rules, select the appropriate destination:

* If the instructions are specific to the agentcubicle container context: `.agentcubicle/AGENTS.local.md`.
* If not:
  * If a git-tracked `AGENTS.md` exists at the project level, ask the user where to put the instructions.
  * Else `.agentcubicle/AGENTS.local.md`.

## Memory

Three places for information to live, each with a different purpose and
lifetime — know which one something belongs in:

- **`.agentcubicle/MEMORY.local.md`** is temporary work memory, not permanent
  documentation. It exists purely for continuity across sessions and
  should hold only:
  - **Current focus**: what's being worked on right now, if anything.
  - **Recent decisions**: choices made recently and their reasoning, so
    they aren't re-litigated next session — until captured permanently
    elsewhere or no longer relevant.
  - **Open threads**: questions, TODOs, or half-finished work to pick
    back up.
  Update it as you go, not just at the end of a session.
- **`README.md`** is user-facing documentation: how to use this project,
  what it does, configuration, behavior a user needs to know.
- **`docs/DESIGN.md`** (and any `docs/DESIGN/*.md` files it references)
  holds design rationale and architecture decisions — the durable "why"
  behind non-obvious choices, git-tracked and permanent, rather than
  buried in commit messages or lost the next time MEMORY.local.md gets
  cleaned up. If the project already has its own established design-doc
  convention (an `ARCHITECTURE.md`, `docs/adr/`, etc.), use that instead
  of introducing a new location — ask the user if it's unclear which to
  prefer. If neither `docs/DESIGN.md` nor an equivalent exists, **ask the
  user before creating it** — do not create it unilaterally. `docs/` may
  already serve some other, unrelated purpose in this particular
  project (a docs site, API reference, etc.), so its absence or a
  differently-used `docs/` is a real signal to check, not just proceed.

Avoid creating memory files that the running tool does not load on its own
(opencode reads the files in its `instructions` list; Claude Code follows
the `@` imports in `CLAUDE.local.md`). `.agentcubicle/MEMORY.local.md` is
the designated place for continuity across sessions. If you need dedicated
memory files beyond that, state their full path, relative to the repo root,
in `.agentcubicle/MEMORY.local.md` so the agent can find them, and prefer
`.agentcubicle/memories/` as their location. This does not apply to a
memory directory a tool manages and loads itself (Claude Code keeps one at
`.agentcubicle/claude-home/projects/<encoded-path>/memory/`, indexed by its
own `MEMORY.md`): leave those where the tool puts them.

Clean up MEMORY.local.md regularly, not just when it gets unwieldy: once
something is captured permanently in README.md or the design docs, or is
resolved/no longer relevant, trim or compress it out rather than letting
it accumulate indefinitely. When unsure whether to delete or keep,
condense to a one-line summary instead of deleting outright.

Regularly — not only when explicitly asked — look back over what has
stacked up in MEMORY.local.md and in recent git history, and use it to update
README.md and the design docs with anything that deserves to live there
permanently. Then clean up MEMORY.local.md accordingly.
AGENTS_EOF
)
_seed_if_absent "$WORKDIR/.agentcubicle/AGENTS.local.md" "$AGENTS_CONTENT"

MEMORY_CONTENT=$(cat <<'MEMORY_EOF'
# MEMORY.local.md (agentcubicle local file)

> Local-only, machine-specific continuity notes maintained by
> `agentcubicle` at `.agentcubicle/MEMORY.local.md`, imported into
> `.agentcubicle/CLAUDE.local.md` (via an `@` include) and read by opencode
> directly via its own `instructions` config entry. Keep this updated
> across sessions as a lightweight, tool-agnostic memory of where things
> stand — update it as you go, not just at the end of a session. Nothing
> here is ever committed, tracked, or shared with anyone who clones the
> repo.

- **Current focus:** what's being worked on right now.
- **Recent decisions:** choices made and the reasoning, so they aren't
  re-litigated next session.
- **Open threads:** questions, TODOs, or half-finished work to pick back up.
MEMORY_EOF
)
_seed_if_absent "$WORKDIR/.agentcubicle/MEMORY.local.md" "$MEMORY_CONTENT"

CLAUDE_CONTENT=$(cat <<'CLAUDE_EOF'
# CLAUDE.local.md (agentcubicle local file, Claude-Code-specific)

> Local-only, machine-specific file maintained by `agentcubicle` at
> `.agentcubicle/CLAUDE.local.md`, exposed at the project root as `CLAUDE.local.md`
> (a symlink). Claude Code loads `CLAUDE.local.md` automatically every
> session. Nothing here is ever committed, tracked, or shared with anyone
> who clones the repo.
>
> Keep ONLY Claude-Code-specific instructions here — things that genuinely
> don't apply to opencode or other tools. Everything else belongs in
> `.agentcubicle/AGENTS.local.md` (general rules) or `.agentcubicle/MEMORY.local.md`
> (working notes). Their content is inlined below via `@` imports, so you
> already have it without needing a separate read — do not re-read either
> file with a tool call, that just adds a needless round trip.

@AGENTS.local.md
@MEMORY.local.md

## Claude-Code-specific instructions

These supersede AGENTS.local.md instructions.

When updating agent rules, select the appropriate destination:

For anything truly Claude-Code-specific:
* If the instructions are specific to the agentcubicle container context: `.agentcubicle/CLAUDE.local.md`.
* If not:
  * If a git-tracked `CLAUDE.md` exists at the project level, ask the user where to put the instructions.
  * Else `.agentcubicle/CLAUDE.local.md`.

For anything not Claude-Code-specific, follow AGENTS.local.md's own instructions on
this matter (same rules, with AGENTS.local.md as the target instead).

(No project-specific Claude Code instructions yet — add any above as they
come up.)
CLAUDE_EOF
)
_seed_if_absent "$WORKDIR/.agentcubicle/CLAUDE.local.md" "$CLAUDE_CONTENT"
# CLAUDE.local.md is a relative symlink so Claude Code picks it up
# automatically every session (matches CLAUDE.md's own documented symlink
# convention). The -L check guards against a previously-created dangling
# symlink making `ln -s` fail outright.
if [[ ! -e "$WORKDIR/CLAUDE.local.md" && ! -L "$WORKDIR/CLAUDE.local.md" ]]; then
  ln -s .agentcubicle/CLAUDE.local.md "$WORKDIR/CLAUDE.local.md"
fi

# Register the persistent Claude state directory and the local files above
# in the repo's local, never-committed git-exclude file — NOT .gitignore,
# which is tracked and would leak which tool/container setup this repo uses
# to anyone who clones it. Applies regardless of which tool is running.
# No-op if the project isn't a git repo. Resolved via --git-common-dir
# (rather than checking `-d "$WORKDIR/.git"`) so this also works inside a
# git worktree or submodule, where `.git` is a file pointing elsewhere, not
# a directory. Guarded by --show-toplevel so this only fires when $WORKDIR
# is itself a repo/worktree root — otherwise --git-common-dir would walk up
# and find an unrelated parent repo when $WORKDIR is a plain subdirectory
# with no .git of its own, and register the exclude entries against the
# wrong root.
GIT_TOPLEVEL="$(git -C "$WORKDIR" rev-parse --show-toplevel 2>/dev/null || true)"
if [[ -n "$GIT_TOPLEVEL" ]] && [[ "$GIT_TOPLEVEL" -ef "$WORKDIR" ]]; then
  GIT_COMMON_DIR="$(git -C "$WORKDIR" rev-parse --git-common-dir)"
  case "$GIT_COMMON_DIR" in
    /*) : ;;
    *) GIT_COMMON_DIR="$WORKDIR/$GIT_COMMON_DIR" ;;
  esac
  EXCLUDE_FILE="$GIT_COMMON_DIR/info/exclude"
  mkdir -p "$(dirname "$EXCLUDE_FILE")"
  for entry in '/.agentcubicle/' '/CLAUDE.local.md'; do
    if ! grep -qxF "$entry" "$EXCLUDE_FILE" 2>/dev/null; then
      printf '%s\n' "$entry" >> "$EXCLUDE_FILE"
    fi
  done
fi

# Auto-detect clipboard/display backend and mount appropriate socket
if [[ -n "${WAYLAND_DISPLAY:-}" && -n "${XDG_RUNTIME_DIR:-}" && -S "$XDG_RUNTIME_DIR/$WAYLAND_DISPLAY" ]]; then
  if [[ "$ENGINE" == podman ]]; then
    # Rootless podman runs as a user whose UID need not match the host, so the
    # host /run/user/<uid> path is not reusable inside (Wayland rejects an
    # XDG_RUNTIME_DIR it thinks another user owns). Stage the socket under a
    # container-local runtime dir and point XDG_RUNTIME_DIR at that.
    EXTRA_MOUNTS+=("-v" "$XDG_RUNTIME_DIR/$WAYLAND_DISPLAY:/tmp/xdg-runtime/$WAYLAND_DISPLAY")
    EXTRA_ENVS+=("-e" "WAYLAND_DISPLAY=$WAYLAND_DISPLAY" "-e" "XDG_RUNTIME_DIR=/tmp/xdg-runtime")
  else
    EXTRA_MOUNTS+=("-v" "$XDG_RUNTIME_DIR/$WAYLAND_DISPLAY:$XDG_RUNTIME_DIR/$WAYLAND_DISPLAY")
    EXTRA_ENVS+=("-e" "WAYLAND_DISPLAY=$WAYLAND_DISPLAY" "-e" "XDG_RUNTIME_DIR=$XDG_RUNTIME_DIR")
  fi
elif [[ -n "${DISPLAY:-}" ]]; then
  EXTRA_MOUNTS+=("-v" "/tmp/.X11-unix:/tmp/.X11-unix")
  if [[ -n "${XAUTHORITY:-}" && -f "$XAUTHORITY" ]]; then
    EXTRA_MOUNTS+=("-v" "$XAUTHORITY:/home/user/.Xauthority")
    EXTRA_ENVS+=("-e" "XAUTHORITY=/home/user/.Xauthority")
  fi
  EXTRA_ENVS+=("-e" "DISPLAY=$DISPLAY")
fi

# Auto-forward a static Claude Code OAuth token (from `claude setup-token`) so
# `agentcubicle claude` just works with no flags, once set up once. Only
# for the claude tool, and only if the caller hasn't already set it via --env.
if [[ "$TOOL" == "claude" ]]; then
  HAS_EXPLICIT_TOKEN=false
  for env_entry in "${EXTRA_ENVS[@]+"${EXTRA_ENVS[@]}"}"; do
    if [[ "$env_entry" == CLAUDE_CODE_OAUTH_TOKEN=* ]]; then
      HAS_EXPLICIT_TOKEN=true
      break
    fi
  done

  if ! $HAS_EXPLICIT_TOKEN; then
    if [[ -n "${CLAUDE_CODE_OAUTH_TOKEN:-}" ]]; then
      EXTRA_ENVS+=("-e" "CLAUDE_CODE_OAUTH_TOKEN=$CLAUDE_CODE_OAUTH_TOKEN")
    elif [[ -s "$HOME/.claude/oauth-token" ]]; then
      EXTRA_ENVS+=("-e" "CLAUDE_CODE_OAUTH_TOKEN=$(cat "$HOME/.claude/oauth-token")")
    fi
  fi

  # Whether claude will actually have something to authenticate with once
  # the container starts, after every detection path above has had a
  # chance to populate EXTRA_ENVS.
  CLAUDE_HAS_CREDENTIALS=false
  for env_entry in "${EXTRA_ENVS[@]+"${EXTRA_ENVS[@]}"}"; do
    if [[ "$env_entry" == CLAUDE_CODE_OAUTH_TOKEN=* || "$env_entry" == ANTHROPIC_API_KEY=* ]]; then
      CLAUDE_HAS_CREDENTIALS=true
      break
    fi
  done
fi

if [[ -n "$HOST_GITCONFIG_B64" ]]; then
  EXTRA_ENVS+=("-e" "HOST_GITCONFIG_B64=$HOST_GITCONFIG_B64")
fi

if [[ -n "$OPENCODE_REDACTED_B64" ]]; then
  EXTRA_ENVS+=("-e" "OPENCODE_REDACTED_B64=$OPENCODE_REDACTED_B64" "-e" "OPENCODE_REDACTED_BASENAME=$OPENCODE_REDACTED_BASENAME")
fi

# Build the inner command that runs as `user` (non-root).
# Base64-encode it to avoid nested quoting issues across shell boundaries.
#
# GIT_SETUP is shared by both tools: it decodes the forwarded host gitconfig
# (if any) straight to a file and points --global include.path at it, rather
# than reconstructing individual `git config` calls from arbitrary values —
# this is deliberate: arbitrary values re-parsed as shell text through the
# su -c reparse below is exactly the bug class fixed elsewhere in this script
# (see the single-quoting around OPENCODE_CONFIG_CONTENT).
GIT_SETUP='if [ -n "$HOST_GITCONFIG_B64" ]; then printf %s "$HOST_GITCONFIG_B64" | base64 -d > "$HOME/.gitconfig-forwarded" && git config --global include.path "$HOME/.gitconfig-forwarded"; fi; git config --global --add safe.directory '"$CONTAINER_PROJECT_DIR"'; '

# Sent as the tool's first turn so the "announce what you read" instruction
# in AGENTS.local.md/CLAUDE.local.md actually has a chance to fire: an interactive TUI
# never gives the model an unprompted turn, so without this the loaded
# instructions just sit there until the user happens to say something.
# Explicitly asks for a quick, non-deliberative first answer, scoped to
# just this one message - it does not touch any model/thinking settings,
# so nothing about later turns is affected.
# No apostrophes/quotes in this text — it survives through the same
# su -c reparse as everything else in INNER_CMD.
KICKOFF_PROMPT='Without spending extra time deliberating, briefly tell me which of your local instructions and memory files you have and give a quick one paragraph summary of what is in them, then stop and wait for what is next.'

if [[ "$TOOL" == "opencode" ]]; then
  INNER_CMD="$GIT_SETUP export OPENCODE_CONFIG_CONTENT='$OPENCODE_CONFIG_JSON'; exec opencode --agent plan --prompt '$KICKOFF_PROMPT' \"\$@\""
elif $CLAUDE_HAS_CREDENTIALS; then
  INNER_CMD="$GIT_SETUP export CLAUDE_CONFIG_DIR=$CONTAINER_PROJECT_DIR/.agentcubicle/claude-home; exec claude --permission-mode plan \"\$@\" '$KICKOFF_PROMPT'"
else
  # No credentials detected on the host. Instead of starting a normal
  # session (which would just hit a login wall), guide the user through
  # `claude setup-token` right here and tell them exactly what to do with
  # the printed token. Ends in an interactive shell (not exec claude) so
  # they have somewhere to type the save command before the container
  # exits. No apostrophes/quotes in this text — it is embedded between
  # single quotes below and survives the same su -c reparse as
  # KICKOFF_PROMPT.
  CLAUDE_BOOTSTRAP_INTRO_MSG=$(cat <<EOF
No Claude Code credentials were found for this container (no oauth-token file, no CLAUDE_CODE_OAUTH_TOKEN, no ANTHROPIC_API_KEY). Generating one now instead of starting a normal session.

claude setup-token will print a URL below. Open it in a browser, log into the Claude account, and authorize. It will then print a token string right here in this terminal - that token is what agentcubicle needs saved on the host so future runs skip this step.
EOF
  )
  CLAUDE_BOOTSTRAP_SUCCESS_MSG=$(cat <<EOF

Save the printed token into the bind-mounted project directory so it survives this container exiting:
  echo <paste token here> > $CONTAINER_PROJECT_DIR/.claude-oauth-token

Then exit this container (exit or Ctrl-D). On the host, run:
  mkdir -p ~/.claude && mv .claude-oauth-token ~/.claude/oauth-token && chmod 600 ~/.claude/oauth-token

Then start a fresh container to confirm it worked: agentcubicle claude
EOF
  )
  INNER_CMD="$GIT_SETUP export CLAUDE_CONFIG_DIR=$CONTAINER_PROJECT_DIR/.agentcubicle/claude-home; echo '$CLAUDE_BOOTSTRAP_INTRO_MSG'; if claude setup-token; then echo '$CLAUDE_BOOTSTRAP_SUCCESS_MSG'; else echo 'Token setup did not finish. Run agentcubicle claude again to retry.'; fi; exec sh"
fi

# Test hook: when AGENTCUBICLE_TEST_CMD is set, replace the interactive tool
# launch with that command so CI can drive the run path headlessly. Not a
# supported user-facing option.
if [[ -n "${AGENTCUBICLE_TEST_CMD:-}" ]]; then
  INNER_CMD="$AGENTCUBICLE_TEST_CMD"
fi
INNER_B64=$(printf '%s' "$INNER_CMD" | base64 -w0)

if [[ "$TOOL" == "claude" ]] && ! $CLAUDE_HAS_CREDENTIALS; then
  echo "No Claude Code credentials detected (no ~/.claude/oauth-token, no CLAUDE_CODE_OAUTH_TOKEN, no ANTHROPIC_API_KEY)."
  echo "Starting a container to generate one via 'claude setup-token' instead of a normal session."
fi

if [[ "$TOOL" == "opencode" ]] && ! $OPENCODE_HAS_PROVIDER; then
  echo "No providers configured in $CONFIG_HOME/opencode.json(c) — only opencode's built-in free models will be available."
  echo "To add a real provider: add a \"provider\" section to that file with an API key referenced as {env:YOUR_VAR}, then pass the actual value with --env YOUR_VAR=... when running agentcubicle opencode."
fi

echo "Starting container: ${CONTAINER_NAME}"

# Whether to allocate a TTY. Dropped in headless test mode (CI has no
# controlling terminal).
RUN_TTY_ARGS=(-it)
if [[ -n "${AGENTCUBICLE_TEST_CMD:-}" ]]; then
  RUN_TTY_ARGS=()
fi

if [[ "$ENGINE" == podman ]]; then
  # Rootless podman: --userns=keep-id maps the host user onto the image's baked
  # UID 1000, so we run as that user directly (no root remap phase) and files
  # written into bind mounts land owned by the host user. Config is staged
  # read-only under /home/user (see CONFIG_HOME_MOUNT_ARGS) and copied into
  # place by the entrypoint, since the unprivileged user cannot read /root.
  # No usermod/groupmod/chown: keep-id already gives files the right owner.
  $ENGINE run ${RUN_TTY_ARGS[@]+"${RUN_TTY_ARGS[@]}"} \
    --name "$CONTAINER_NAME" \
    --entrypoint sh \
    --userns=keep-id:uid=1000,gid=1000 \
    --security-opt label=disable \
    -w "$CONTAINER_PROJECT_DIR" \
    -v "$WORKDIR:$CONTAINER_PROJECT_DIR:rw" \
    ${CONFIG_HOME_MOUNT_ARGS[@]+"${CONFIG_HOME_MOUNT_ARGS[@]}"} \
    ${EXTRA_MOUNTS[@]+"${EXTRA_MOUNTS[@]}"} \
    -e HOME=/home/user \
    -e "INNER_B64=$INNER_B64" \
    -e "TOOL=$TOOL" \
    ${EXTRA_ENVS[@]+"${EXTRA_ENVS[@]}"} \
    "$IMAGE" \
    -c \
    'mkdir -p /home/user/.config/opencode
     if [ -n "$OPENCODE_REDACTED_B64" ]; then
       printf %s "$OPENCODE_REDACTED_B64" | base64 -d > "/home/user/.config/opencode/$OPENCODE_REDACTED_BASENAME"
     elif [ -f /home/user/.config-host/opencode/opencode.json ]; then
       cp /home/user/.config-host/opencode/opencode.json /home/user/.config/opencode/
     elif [ -f /home/user/.config-host/opencode/opencode.jsonc ]; then
       cp /home/user/.config-host/opencode/opencode.jsonc /home/user/.config/opencode/
     fi
     if [ "$TOOL" = "claude" ]; then
       CLAUDE_STATE_DIR=/home/user/project/.agentcubicle/claude-home
       mkdir -p "$CLAUDE_STATE_DIR"
       if [ ! -f "$CLAUDE_STATE_DIR/settings.json" ] && [ -f /home/user/.config-host/claude/settings.json ]; then
         cp /home/user/.config-host/claude/settings.json "$CLAUDE_STATE_DIR/"
       fi
       if [ -f "$CLAUDE_STATE_DIR/settings.json" ]; then
         jq ". + {skipDangerousModePermissionPrompt: true}" "$CLAUDE_STATE_DIR/settings.json" > "$CLAUDE_STATE_DIR/settings.json.tmp" \
           && mv "$CLAUDE_STATE_DIR/settings.json.tmp" "$CLAUDE_STATE_DIR/settings.json"
       else
         echo "{\"skipDangerousModePermissionPrompt\": true}" > "$CLAUDE_STATE_DIR/settings.json"
       fi
       echo "{\"hasCompletedOnboarding\": true, \"projects\": {\"/home/user/project\": {\"hasTrustDialogAccepted\": true}}}" > "$CLAUDE_STATE_DIR/.claude.json"
     fi
     CMD=$(echo "$INNER_B64" | base64 -d)
     exec sh -c "export PATH=\"/home/user/.local/bin:\$PATH\"; $CMD" _ "$@"' \
    _ ${EXTRA_ARGS[@]+"${EXTRA_ARGS[@]}"}
else
# Container starts as root → remaps `user` UID/GID to host → su's to user.
$ENGINE run ${RUN_TTY_ARGS[@]+"${RUN_TTY_ARGS[@]}"} \
  --name "$CONTAINER_NAME" \
  --entrypoint sh \
  -w "$CONTAINER_PROJECT_DIR" \
  -v "$WORKDIR:$CONTAINER_PROJECT_DIR:rw" \
  ${CONFIG_HOME_MOUNT_ARGS[@]+"${CONFIG_HOME_MOUNT_ARGS[@]}"} \
  ${EXTRA_MOUNTS[@]+"${EXTRA_MOUNTS[@]}"} \
  -e HOME=/root \
  -e "HOST_UID=$(id -u)" \
  -e "HOST_GID=$(id -g)" \
  -e "INNER_B64=$INNER_B64" \
  -e "TOOL=$TOOL" \
  ${EXTRA_ENVS[@]+"${EXTRA_ENVS[@]}"} \
  "$IMAGE" \
  -c \
  'groupmod -g $HOST_GID user
   usermod -u $HOST_UID user
   mkdir -p /home/user/.config/opencode
   if [ -n "$OPENCODE_REDACTED_B64" ]; then
     printf %s "$OPENCODE_REDACTED_B64" | base64 -d > "/home/user/.config/opencode/$OPENCODE_REDACTED_BASENAME"
   elif [ -f /root/.config/opencode/opencode.json ]; then
     cp /root/.config/opencode/opencode.json /home/user/.config/opencode/
   elif [ -f /root/.config/opencode/opencode.jsonc ]; then
     cp /root/.config/opencode/opencode.jsonc /home/user/.config/opencode/
   fi
   if [ "$TOOL" = "claude" ]; then
     CLAUDE_STATE_DIR=/home/user/project/.agentcubicle/claude-home
     mkdir -p "$CLAUDE_STATE_DIR"
     # Seed from the host settings.json only once. CLAUDE_STATE_DIR now
     # persists across container recreations (unlike the throwaway HOME
     # this used to live in), so unconditionally re-copying here would
     # clobber any settings changes accumulated in a previous session.
     if [ ! -f "$CLAUDE_STATE_DIR/settings.json" ] && [ -f /root/.claude/settings.json ]; then
       cp /root/.claude/settings.json "$CLAUDE_STATE_DIR/"
     fi
     if [ -f "$CLAUDE_STATE_DIR/settings.json" ]; then
       jq ". + {skipDangerousModePermissionPrompt: true}" "$CLAUDE_STATE_DIR/settings.json" > "$CLAUDE_STATE_DIR/settings.json.tmp" \
         && mv "$CLAUDE_STATE_DIR/settings.json.tmp" "$CLAUDE_STATE_DIR/settings.json"
     else
       echo "{\"skipDangerousModePermissionPrompt\": true}" > "$CLAUDE_STATE_DIR/settings.json"
     fi
     # Claude Code resolves its onboarding/trust-dialog state file relative
     # to CLAUDE_CONFIG_DIR when that env var is set (confirmed by reading
     # the actual binary config-path resolver directly), not at
     # $HOME/.claude.json, so the stub has to live inside CLAUDE_STATE_DIR
     # (which is what CLAUDE_CONFIG_DIR points at below), or the onboarding
     # wizard shows up every run despite this file existing at the old,
     # wrong location.
     echo "{\"hasCompletedOnboarding\": true, \"projects\": {\"/home/user/project\": {\"hasTrustDialogAccepted\": true}}}" > "$CLAUDE_STATE_DIR/.claude.json"
     # claude-home lives inside the project mount, which the chown -R below
     # deliberately skips (see docs/DESIGN.md). The root-phase mkdir/seeds
     # above therefore leave it root:root, and the unprivileged user we
     # drop to would hit EACCES. Chown it back explicitly here
     # (unconditional, so a dir left
     # root-owned by an older buggy run self-heals on the next run).
     chown -R $HOST_UID:$HOST_GID "$CLAUDE_STATE_DIR"
   fi
   chown $HOST_UID:$HOST_GID /home/user
   # Skip project (the project bind mount) and .Xauthority (a host file
   # mounted read-write for X11 forwarding): both already carry the host
   # UID/GID on disk, so recursing into them would only waste time and
   # needlessly touch every inode of the actual project tree.
   find /home/user -mindepth 1 -maxdepth 1 ! -name project ! -name .Xauthority -exec chown -R $HOST_UID:$HOST_GID {} +
    export HOME=/home/user
    CMD=$(echo "$INNER_B64" | base64 -d)
    exec su -s /bin/sh -c "export PATH=\"/home/user/.local/bin:\$PATH\"; $CMD" user _ "$@"' \
  _ ${EXTRA_ARGS[@]+"${EXTRA_ARGS[@]}"}
fi



#!/bin/bash
# Run opencode or claude in an isolated Docker container, starting in a read-only
# plan mode you manually escalate out of. Project files are mounted read-write.
#
# Usage:
#   agentcubicle setup [--clear] [--claude]               # Build base image; --claude adds Claude Code
#   agentcubicle check [--img IMAGE]                     # Inspect image for required tools
#   agentcubicle commit [--name NAME]                     # Commit running container
#   agentcubicle cleanup                                  # Remove stopped containers
#   agentcubicle <opencode|claude> [--mount MOUNT] [--env ENV] [--img IMAGE] [--name NAME] [--] [tool args...]
#
# Examples:
#   agentcubicle setup
#   agentcubicle setup --claude
#   agentcubicle setup --clear
#   agentcubicle check
#   agentcubicle commit
#   agentcubicle commit --name ac-myproject-abc123
#   agentcubicle cleanup
#   agentcubicle opencode
#   agentcubicle claude
#   agentcubicle opencode --name my-session
#   agentcubicle claude --env ANTHROPIC_API_KEY="$(cat ~/.claude-key)"
#   agentcubicle opencode --mount /etc/ssh:/etc/ssh:ro
#   agentcubicle claude -- --model sonnet

set -euo pipefail

WORKDIR="$(pwd)"
CONTAINER_PROJECT_DIR="/home/user/project"
COMMIT_TARGET="agentcubicle"
EXTRA_MOUNTS=()
EXTRA_ENVS=()
EXTRA_ARGS=()
PARSE_DASHDASH=false
CLEAR=false
COMMAND=""
TOOL=""
CMD_NAME=""

# Packages and the binary to check for them. Format: "package:binary"
# If no colon, the binary has the same name as the package.
REQUIRED_PACKAGES=(
  "bat"
  "build-base:make"
  "cgdb"
  "curl"
  "curlie"
  "diffutils:diff"
  "file"
  "fzf"
  "gcc"
  "g++"
  "gdb"
  "gdb-dashboard:gdb"
  "git"
  "htop"
  "httpie"
  "jq"
  "lua5.4"
  "luajit"
  "lsof"
  "nano"
  "netcat-openbsd:nc"
  "nmap"
  "nodejs:node"
  "npm"
  "patch"
  "perl"
  "python3"
  "py3-pip:pip3"
  "shellcheck"
  "sqlite"
  "strace"
  "tcpdump"
  "tmux"
  "tree"
  "valgrind"
  "vim"
  "wl-clipboard:wl-copy"
  "wrk"
  "xclip"
)

# Resolve binary name for a package entry: "pkg:bin" → bin, "pkg" → pkg
_pkg_to_bin() {
  echo "${1#*:}"
}

# Default image for `check` and run
IMAGE="$COMMIT_TARGET"

# Generate unique container name: ac-<project>-<random>
_generate_name() {
  local sanitized
  sanitized="$(basename "$WORKDIR" | sed 's/[^a-zA-Z0-9_-]/-/g')"
  local rand
  rand="$(od -An -tx1 -N4 /dev/urandom | tr -d ' \n')"
  echo "ac-${sanitized}-${rand}"
}

# Determine config home directory based on tool
_config_home() {
  if [[ "$TOOL" == "opencode" ]]; then
    echo "$HOME/.config/opencode"
  else
    echo "$HOME/.claude"
  fi
}

# --- Phase 1: extract top-level subcommands (no tool context) ---
if [[ $# -gt 0 ]]; then
  case "$1" in
    setup|check|commit|cleanup)
      COMMAND="$1"
      shift
      ;;
  esac
fi

# Parse `setup` flags
if [[ "$COMMAND" == "setup" ]]; then
  while [[ $# -gt 0 ]]; do
    case $1 in
      --clear)
        CLEAR=true
        shift
        ;;
      --claude)
        EXTRA_ARGS+=("--claude")
        shift
        ;;
      *)
        echo "Error: unknown argument '$1' for setup."
        echo "Usage: agentcubicle setup [--clear] [--claude]"
        exit 1
        ;;
    esac
  done
fi

# Parse `check` flags
if [[ "$COMMAND" == "check" ]]; then
  while [[ $# -gt 0 ]]; do
    case $1 in
      --img)
        IMAGE="$2"
        shift 2
        ;;
      *)
        echo "Error: unknown argument '$1' for check."
        echo "Usage: agentcubicle check [--img IMAGE]"
        exit 1
        ;;
    esac
  done
fi

# Parse `commit` flags
if [[ "$COMMAND" == "commit" ]]; then
  while [[ $# -gt 0 ]]; do
    case $1 in
      --name)
        CMD_NAME="$2"
        shift 2
        ;;
      *)
        echo "Error: unknown argument '$1' for commit."
        echo "Usage: agentcubicle commit [--name NAME]"
        exit 1
        ;;
    esac
  done
fi

# --- Phase 2: run mode — requires opencode ---
if [[ -z "$COMMAND" ]]; then
  if [[ $# -lt 1 ]] || [[ "$1" == "--" ]]; then
    echo "Error: First argument must be 'opencode' or 'claude'."
    echo ""
    echo "Usage: agentcubicle <opencode|claude> [options...] [--] [tool args...]"
    echo "       agentcubicle setup [--clear] [--claude]"
    echo "       agentcubicle check [--img IMAGE]"
    echo "       agentcubicle commit [--name NAME]"
    echo "       agentcubicle cleanup"
    exit 1
  fi

  TOOL="$1"
  shift

  if [[ "$TOOL" != "opencode" && "$TOOL" != "claude" ]]; then
    echo "Error: Unknown tool '$TOOL'. Must be 'opencode' or 'claude'."
    exit 1
  fi

  # Parse remaining arguments for run
  while [[ $# -gt 0 ]]; do
    if $PARSE_DASHDASH; then
      EXTRA_ARGS+=("$1")
      shift
      continue
    fi

    case $1 in
      --name)
        CMD_NAME="$2"
        shift 2
        ;;
      --img)
        IMAGE="$2"
        shift 2
        ;;
      --mount)
        EXTRA_MOUNTS+=("-v" "$2")
        shift 2
        ;;
      --env)
        EXTRA_ENVS+=("-e" "$2")
        shift 2
        ;;
      --)
        PARSE_DASHDASH=true
        shift
        ;;
      *)
        EXTRA_ARGS+=("$1")
        shift
        ;;
    esac
  done
fi

# --- subcommand handlers ---

# -- setup: build custom image with dev tools and clipboard --
if [[ "$COMMAND" == "setup" ]]; then
  INSTALL_CLAUDE=false
  for arg in "${EXTRA_ARGS[@]+"${EXTRA_ARGS[@]}"}"; do
    if [[ "$arg" == "--claude" ]]; then
      INSTALL_CLAUDE=true
    fi
  done

  # Remove existing image first if --clear is set
  if $CLEAR; then
    docker image rm -f "$COMMIT_TARGET" >/dev/null 2>/dev/null || true
  fi

  NO_CACHE_ARGS=()
  if $CLEAR; then
    NO_CACHE_ARGS=(--no-cache)
  fi

  NEEDS_BASE=false
  NEEDS_CLAUDE=false
  HAS_CLAUDE=false

  if docker image inspect "$COMMIT_TARGET" >/dev/null 2>&1; then
    if docker run --entrypoint sh --rm "$COMMIT_TARGET" -c "test -x /home/user/.local/bin/claude" 2>/dev/null; then
      HAS_CLAUDE=true
    fi

    if $INSTALL_CLAUDE && ! $HAS_CLAUDE; then
      NEEDS_CLAUDE=true
    elif ! $INSTALL_CLAUDE; then
      echo "Image $COMMIT_TARGET is ready."
      if $HAS_CLAUDE; then
        echo "Claude Code is also installed."
      fi
      exit 0
    fi
  else
    NEEDS_BASE=true
  fi

  PKG_NAMES=()
  for entry in "${REQUIRED_PACKAGES[@]}"; do
    PKG_NAMES+=("${entry%%:*}")
  done

  # Build base + optionally claude in one go
  BUILD_CLAUDE=false
  if $NEEDS_BASE && $INSTALL_CLAUDE; then
    BUILD_CLAUDE=true
  fi

  if $NEEDS_BASE; then
    echo "Building $COMMIT_TARGET with dev tools ..."
    docker build --progress=plain ${NO_CACHE_ARGS[@]+"${NO_CACHE_ARGS[@]}"} --build-arg PACKAGES="${PKG_NAMES[*]}" --build-arg INSTALL_CLAUDE="$BUILD_CLAUDE" -t "$COMMIT_TARGET" - < <(
      cat <<'EOF'
FROM ghcr.io/anomalyco/opencode
ARG PACKAGES
ARG INSTALL_CLAUDE
RUN apk add --no-cache $PACKAGES bash libgcc libstdc++ ripgrep shadow
RUN addgroup -g 1000 user 2>/dev/null || true
RUN adduser -u 1000 -G user -D -h /home/user user 2>/dev/null || true
RUN mkdir -p /usr/local/bin
ENV PATH="/usr/local/bin:$PATH"
ENV USE_BUILTIN_RIPGREP=0
RUN if [ "$INSTALL_CLAUDE" = "true" ]; then su -s /bin/sh user -c 'export PATH="/home/user/.local/bin:$PATH" USE_BUILTIN_RIPGREP=0; curl -fsSL https://claude.ai/install.sh | bash'; fi
EOF
    )
    echo "Done. Image '$COMMIT_TARGET' is ready."
  fi

  # If image existed but lacks claude, add it on top
  if $NEEDS_CLAUDE; then
    echo "Adding claude to $COMMIT_TARGET ..."
    docker build --progress=plain ${NO_CACHE_ARGS[@]+"${NO_CACHE_ARGS[@]}"} -t "$COMMIT_TARGET" - < <(
       cat <<EOF
FROM $COMMIT_TARGET
RUN apk add --no-cache shadow
RUN addgroup -g 1000 user 2>/dev/null || true; adduser -u 1000 -G user -D -h /home/user user 2>/dev/null || true
RUN mkdir -p /usr/local/bin
ENV PATH="/usr/local/bin:\$PATH"
ENV USE_BUILTIN_RIPGREP=0
RUN su -s /bin/sh user -c 'export PATH="/home/user/.local/bin:$PATH" USE_BUILTIN_RIPGREP=0; curl -fsSL https://claude.ai/install.sh | bash'
EOF
    )
    echo "Done. Claude Code is installed."
  else
    echo "Image $COMMIT_TARGET is ready."
    if $HAS_CLAUDE; then
      echo "Claude Code is already installed."
    fi
  fi

  exit 0
fi

# -- check: inspect image for required tools --
if [[ "$COMMAND" == "check" ]]; then
  _ok() { echo "  ✓ $1"; }
  _missing() { echo "  ✗ $1 (missing)"; }

  echo "Checking image '$IMAGE' ..."
  MISSING=0

  for entry in "${REQUIRED_PACKAGES[@]}"; do
    PKG="${entry%%:*}"
    BIN="$(_pkg_to_bin "$entry")"
    if docker run --entrypoint sh --rm "$IMAGE" -c "command -v $BIN >/dev/null" 2>/dev/null; then
      _ok "$PKG"
    else
      _missing "$PKG"
      MISSING=1
    fi
  done

  # Also check for claude (installed to /home/user/.local/bin/claude)
  if docker run --entrypoint sh --rm "$IMAGE" -c "test -x /home/user/.local/bin/claude" 2>/dev/null; then
    _ok "claude"
  else
    _missing "claude"
    MISSING=1
  fi

  if [[ "$MISSING" -eq 1 ]]; then
    echo ""
    echo "Run 'agentcubicle setup' to install missing tools into $COMMIT_TARGET."
  fi
  exit 0
fi

# -- cleanup --
if [[ "$COMMAND" == "cleanup" ]]; then
  for cid in $(docker ps -a --filter 'name=^ac-' --filter 'status=exited' --format '{{.ID}}' 2>/dev/null || true); do
    docker rm "$cid"
  done
  exit 0
fi

# -- commit --
if [[ "$COMMAND" == "commit" ]]; then
  if [[ -n "$CMD_NAME" ]]; then
    docker commit "$CMD_NAME" "$COMMIT_TARGET"
    exit 0
  fi

  # List running ac-* containers
  CONTAINERS=$(docker ps --filter 'name=^ac-' --format '{{.Names}}' 2>/dev/null || true)
  if [[ -z "$CONTAINERS" ]]; then
    echo "No running containers prefixed with 'ac-' found."
    exit 1
  fi

  echo "Running containers:"
  IDX=1
  NAMES=()
  while IFS= read -r name; do
    [[ -z "$name" ]] && continue
    NAMES+=("$name")
    echo "  ${IDX}) ${name}"
    IDX=$((IDX + 1))
  done <<< "$CONTAINERS"

  if [[ ! -t 0 ]]; then
    echo "Error: no tty available. Use --name to specify a container (not interactive)."
    exit 1
  fi

  echo -n "Pick a container [1]: "
  read -r REPLY_CHOICE
  CHOICE="${REPLY_CHOICE:-1}"

  if ! [[ "$CHOICE" =~ ^[0-9]+$ ]] || [[ "$CHOICE" -lt 1 || "$CHOICE" -gt "${#NAMES[@]}" ]]; then
    echo "Invalid choice."
    exit 1
  fi

  docker commit "${NAMES[$((CHOICE - 1))]}" "$COMMIT_TARGET"
  exit 0
fi

# --- Normal mode: start a container ---
if ! docker image inspect "$IMAGE" >/dev/null 2>&1; then
  echo "Error: $IMAGE image not found."
  if [[ "$IMAGE" == "$COMMIT_TARGET" ]]; then
    echo "Run 'agentcubicle setup' first."
  fi
  exit 1
fi

CONTAINER_NAME="${CMD_NAME:-$(_generate_name)}"

# Remove only if a name was explicitly provided (re-use same name)
if [[ -n "$CMD_NAME" ]]; then
  docker rm -f "$CONTAINER_NAME" 2>/dev/null || true
fi

CONFIG_HOME="$(_config_home)"
DOCKER_CONFIG_ROOT="${CONFIG_HOME#"$HOME"}"

# For claude, mount only settings.json (the one file the entrypoint ever
# reads from here) rather than the whole ~/.claude directory, so the
# oauth-token file (and the raw .credentials.json) never enter the
# container's mount namespace at all - the oauth token is already forwarded
# separately as an env var below. Guarded on existence: bind-mounting a
# single file that does not yet exist on the host causes Docker to create
# an empty directory there instead, which would corrupt a future
# `claude setup-token` save.
CONFIG_HOME_MOUNT_ARGS=()
if [[ "$TOOL" == "claude" ]]; then
  if [[ -f "$CONFIG_HOME/settings.json" ]]; then
    CONFIG_HOME_MOUNT_ARGS=(-v "$CONFIG_HOME/settings.json:/root/.claude/settings.json:ro")
  fi
else
  CONFIG_HOME_MOUNT_ARGS=(-v "$CONFIG_HOME:/root${DOCKER_CONFIG_ROOT}:ro")
fi

# Container-only opencode config override (never touches host config): a
# blanket permission allow. Combined with --agent plan below, this makes
# plan mode best-effort rather than a hard guarantee — opencode's own
# plan-agent rules deny edits, but this blanket allow is appended after
# them in the resolved rule list, so it can win. Accepted trade-off.
OPENCODE_CONFIG_JSON='{"permission":{"*":"allow"}}'

# Auto-detect clipboard/display backend and mount appropriate socket
if [[ -n "${WAYLAND_DISPLAY:-}" && -n "${XDG_RUNTIME_DIR:-}" && -S "$XDG_RUNTIME_DIR/$WAYLAND_DISPLAY" ]]; then
  EXTRA_MOUNTS+=("-v" "$XDG_RUNTIME_DIR/$WAYLAND_DISPLAY:$XDG_RUNTIME_DIR/$WAYLAND_DISPLAY")
  EXTRA_ENVS+=("-e" "WAYLAND_DISPLAY=$WAYLAND_DISPLAY" "-e" "XDG_RUNTIME_DIR=$XDG_RUNTIME_DIR")
elif [[ -n "${DISPLAY:-}" ]]; then
  EXTRA_MOUNTS+=("-v" "/tmp/.X11-unix:/tmp/.X11-unix")
  if [[ -n "${XAUTHORITY:-}" && -f "$XAUTHORITY" ]]; then
    EXTRA_MOUNTS+=("-v" "$XAUTHORITY:/home/user/.Xauthority")
    EXTRA_ENVS+=("-e" "XAUTHORITY=/home/user/.Xauthority")
  fi
  EXTRA_ENVS+=("-e" "DISPLAY=$DISPLAY")
fi

# Auto-forward a static Claude Code OAuth token (from `claude setup-token`) so
# `agentcubicle claude` just works with no flags, once set up once. Only
# for the claude tool, and only if the caller hasn't already set it via --env.
if [[ "$TOOL" == "claude" ]]; then
  HAS_EXPLICIT_TOKEN=false
  for env_entry in "${EXTRA_ENVS[@]+"${EXTRA_ENVS[@]}"}"; do
    if [[ "$env_entry" == CLAUDE_CODE_OAUTH_TOKEN=* ]]; then
      HAS_EXPLICIT_TOKEN=true
      break
    fi
  done

  if ! $HAS_EXPLICIT_TOKEN; then
    if [[ -n "${CLAUDE_CODE_OAUTH_TOKEN:-}" ]]; then
      EXTRA_ENVS+=("-e" "CLAUDE_CODE_OAUTH_TOKEN=$CLAUDE_CODE_OAUTH_TOKEN")
    elif [[ -s "$HOME/.claude/oauth-token" ]]; then
      EXTRA_ENVS+=("-e" "CLAUDE_CODE_OAUTH_TOKEN=$(cat "$HOME/.claude/oauth-token")")
    fi
  fi
fi

# Build the inner command that runs as `user` (non-root), base64-encoded to
# avoid nested quoting issues across the shell boundary. opencode carries its
# container-only config override; claude starts in its own built-in plan mode.
if [[ "$TOOL" == "opencode" ]]; then
  INNER_CMD="export OPENCODE_CONFIG_CONTENT='$OPENCODE_CONFIG_JSON'; exec opencode --agent plan \"\$@\""
else
  INNER_CMD="exec claude --permission-mode plan \"\$@\""
fi
INNER_B64=$(printf '%s' "$INNER_CMD" | base64 -w0)

echo "Starting container: ${CONTAINER_NAME}"

# The container's $HOME (/home/user) is throwaway scratch space, discarded
# when the container exits; the project is bind-mounted at a clearly
# separate child path (/home/user/project) so it's never ambiguous which
# files are ephemeral container state and which are the user's real work.
# Container starts as root → remaps `user` UID/GID to host → su's to user.
docker run -it \
  --name "$CONTAINER_NAME" \
  --entrypoint sh \
  -w "$CONTAINER_PROJECT_DIR" \
  -v "$WORKDIR:$CONTAINER_PROJECT_DIR:rw" \
  ${CONFIG_HOME_MOUNT_ARGS[@]+"${CONFIG_HOME_MOUNT_ARGS[@]}"} \
  ${EXTRA_MOUNTS[@]+"${EXTRA_MOUNTS[@]}"} \
  -e HOME=/home/user \
  -e "HOST_UID=$(id -u)" \
  -e "HOST_GID=$(id -g)" \
  -e "INNER_B64=$INNER_B64" \
  -e "TOOL=$TOOL" \
  ${EXTRA_ENVS[@]+"${EXTRA_ENVS[@]}"} \
  "$IMAGE" \
  -c \
  'groupmod -g $HOST_GID user
   usermod -u $HOST_UID user
   mkdir -p /home/user/.config/opencode
   if [ -f /root/.config/opencode/opencode.json ]; then
     cp /root/.config/opencode/opencode.json /home/user/.config/opencode/
   elif [ -f /root/.config/opencode/opencode.jsonc ]; then
     cp /root/.config/opencode/opencode.jsonc /home/user/.config/opencode/
   fi
   if [ "$TOOL" = "claude" ] && [ -f /root/.claude/settings.json ]; then
     mkdir -p /home/user/.claude
     cp /root/.claude/settings.json /home/user/.claude/
   fi
   chown $HOST_UID:$HOST_GID /home/user
   # Skip project (the project bind mount) and .Xauthority (a host file
   # mounted read-write for X11 forwarding): both already carry the host
   # UID/GID on disk, so recursing into them would only waste time and
   # needlessly touch every inode of the actual project tree.
   find /home/user -mindepth 1 -maxdepth 1 ! -name project ! -name .Xauthority -exec chown -R $HOST_UID:$HOST_GID {} +
   export HOME=/home/user
   CMD=$(echo "$INNER_B64" | base64 -d)
   exec su -s /bin/sh -c "export PATH=\"/home/user/.local/bin:\$PATH\"; $CMD" user _ "$@"' \
  _ ${EXTRA_ARGS[@]+"${EXTRA_ARGS[@]}"}

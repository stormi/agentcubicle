#!/bin/bash
# Run opencode or claude in an isolated container (Docker or rootless Podman),
# starting in a read-only plan mode you manually escalate out of. Project files
# are mounted read-write. The engine is auto-detected (Podman preferred when
# both are installed); set AGENTCUBICLE_ENGINE=docker or =podman to override.
#
# Usage:
#   agentcubicle setup [--clear] [--claude]               # Build base image; --claude adds Claude Code
#   agentcubicle check [--img IMAGE]                     # Inspect image for required tools
#   agentcubicle list [--name NAME]                      # List containers
#   agentcubicle shell [--name NAME]                     # Shell into running container
#   agentcubicle commit [--name NAME]                     # Commit running container
#   agentcubicle cleanup                                  # Remove stopped containers
#   agentcubicle share <create NAME|list|rm NAME>         # Manage named shares (host dirs)
#   agentcubicle [<command>|<opencode|claude>] --help     # Help for agentcubicle itself
#   agentcubicle <opencode|claude> [--mount MOUNT] [--share NAME[:ro|:rw]] [--share-dir PATH[:ro|:rw]] [--env ENV] [--img IMAGE] [--name NAME] [--keep-container] [--] [tool args...]
#   agentcubicle claude [--account NAME] [...]           # Use ~/.claude/oauth-token-NAME instead of ~/.claude/oauth-token
#
# Examples:
#   agentcubicle list
#   agentcubicle shell
#   agentcubicle shell --name ac-myproject-abc123
#   agentcubicle setup
#   agentcubicle setup --claude
#   agentcubicle setup --clear
#   agentcubicle check
#   agentcubicle commit
#   agentcubicle commit --name ac-myproject-abc123
#   agentcubicle cleanup
#   agentcubicle opencode
#   agentcubicle claude
#   agentcubicle opencode --name my-session
#   agentcubicle opencode --keep-container
#   agentcubicle claude --account perso
#   agentcubicle claude --env ANTHROPIC_API_KEY="$(cat ~/.claude-key)"
#   agentcubicle opencode --mount /etc/ssh:/etc/ssh:ro
#   agentcubicle share create xchg
#   agentcubicle claude --share xchg
#   agentcubicle opencode --share xchg:ro
#   agentcubicle claude --share-dir ~/src/other-project/docs
#   agentcubicle claude -- --model sonnet
#   agentcubicle claude -- --help                        # Claude Code's own help

set -euo pipefail

# Everything below is keyed to the identity of the invoking user: the container
# remaps its `user` account onto that UID/GID so files written into the project
# mount come out owned by the caller, and tool config is read from $HOME.
# Neither works as root. UID 0 collides with the container root account, so the
# remap fails and the unprivileged user we drop to ends up with a home it cannot
# write, and $HOME is /root, so the config that gets forwarded belongs to root
# rather than to the caller. Refuse here, before engine detection, instead of
# failing deep inside the container with errors that point elsewhere.
# See docs/DESIGN.md, "Running as root is not supported".
if [[ "$(id -u)" -eq 0 ]]; then
  {
    echo "Error: agentcubicle does not run as root, including under sudo."
    echo
    echo "It maps your host UID/GID onto the container user so files land owned by you,"
    echo "and it reads tool config from \$HOME. As root the UID remap collides with the"
    echo "container root account, and \$HOME is /root, so it would forward root config"
    echo "instead of yours."
    echo
    if [[ -n "${SUDO_USER:-}" ]]; then
      echo "Run it again as $SUDO_USER, without sudo. If sudo was needed because"
      echo "$SUDO_USER cannot reach the container engine, pick one of:"
    else
      echo "Log in as your normal user instead. If that user cannot reach the container"
      echo "engine, pick one of:"
    fi
    echo "  - Add the user to the docker group, then start a fresh login (or newgrp docker):"
    echo "      sudo usermod -aG docker <user>"
    echo "  - Or use rootless podman, which needs no group membership and no sudo."
    echo
    echo "This refusal covers the management subcommands too, so containers left behind"
    echo "by an earlier root run have to be removed with the engine directly:"
    echo "      sudo docker ps -a --filter name=^ac-"
    echo "      sudo docker rm <name>"
    echo "Substitute podman for docker if that was the engine."
  } >&2
  exit 1
fi

WORKDIR="$(pwd)"
CONTAINER_PROJECT_DIR="/home/user/project"
COMMIT_TARGET="agentcubicle"
EXTRA_MOUNTS=()
EXTRA_ENVS=()
EXTRA_ARGS=()
PARSE_DASHDASH=false
CLEAR=false
COMMAND=""
TOOL=""
CMD_NAME=""
KEEP_CONTAINER=false
ACCOUNT=""

# Named shares: plain host directories under one fixed root, mounted into the
# containers that opt in with --share NAME[:ro|:rw] at /shares/NAME. They live
# outside any project and are mounted outside /home/user, so neither the repo
# nor the root-phase chown of the home ever touches them. See docs/DESIGN.md,
# "Named shares".
SHARES_ROOT="${XDG_DATA_HOME:-$HOME/.local/share}/agentcubicle/shares"
CONTAINER_SHARES_DIR="/shares"
# Claude Code only reads outside its working directory with a permission
# prompt, so each enabled share is also passed as --add-dir (built below),
# each path already shell-quoted.
CLAUDE_ADD_DIRS=""
# Container paths taken by --share and --share-dir, to refuse two sources
# landing on the same /shares/NAME.
SHARE_TARGETS=()

# Quote $1 for the POSIX sh that runs INNER_CMD.
_sh_quote() {
  printf "'%s'" "${1//\'/\'\\\'\'}"
}

# Mount host dir $1 at /shares/$2 with mode $3, and pass it to claude.
_add_share_mount() {
  local target="$CONTAINER_SHARES_DIR/$2"
  local t
  for t in ${SHARE_TARGETS[@]+"${SHARE_TARGETS[@]}"}; do
    if [[ "$t" == "$target" ]]; then
      echo "Error: two shares would both be mounted at $target." >&2
      exit 1
    fi
  done
  SHARE_TARGETS+=("$target")
  EXTRA_MOUNTS+=("-v" "$1:$target:$3")
  CLAUDE_ADD_DIRS+=" $(_sh_quote "$target")"
}

_validate_share_name() {
  if [[ ! "$1" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]]; then
    echo "Error: invalid share name '$1'. Use letters, digits, '.', '_' and '-', starting with a letter or digit." >&2
    exit 1
  fi
}

# Usage lines, shared by --help and the argument errors.
USAGE_RUN="agentcubicle <opencode|claude> [options...] [--] [tool args...]"
USAGE_SETUP="agentcubicle setup [--clear] [--claude]"
USAGE_CHECK="agentcubicle check [--img IMAGE]"
USAGE_LIST="agentcubicle list [--name NAME]"
USAGE_SHELL="agentcubicle shell [--name NAME]"
USAGE_COMMIT="agentcubicle commit [--name NAME]"
USAGE_CLEANUP="agentcubicle cleanup"
USAGE_SHARE="agentcubicle share <create NAME|list|rm NAME>"

_print_usage() {
  echo "Usage: $USAGE_RUN"
  echo "       $USAGE_SETUP"
  echo "       $USAGE_CHECK"
  echo "       $USAGE_LIST"
  echo "       $USAGE_SHELL"
  echo "       $USAGE_COMMIT"
  echo "       $USAGE_CLEANUP"
  echo "       $USAGE_SHARE"
  echo
  echo "Run 'agentcubicle <command> --help' (or 'agentcubicle claude --help') for details."
}

_print_run_help() {
  echo "Usage: agentcubicle $1 [options...] [--] [$1 args...]"
  echo
  echo "Start $1 in a new container, with the current directory mounted as the project."
  echo
  echo "Options:"
  echo "  --name NAME                Container name (an existing container with that name is replaced)"
  echo "  --img IMAGE                Image to use instead of the default agentcubicle image"
  echo "  --mount SRC:DST[:ro]       Extra bind mount, passed to the engine as -v. Repeatable."
  echo "  --share NAME[:ro|:rw]      Mount named share NAME at /shares/NAME, read-write by default. Repeatable."
  echo "  --share-dir PATH[:ro|:rw]  Mount host directory PATH at /shares/<basename>, read-only by default. Repeatable."
  echo "  --env VAR=VALUE            Extra environment variable. Repeatable."
  echo "  --keep-container           Keep the container after $1 exits"
  if [[ "$1" == claude ]]; then
    echo "  --account NAME             Use ~/.claude/oauth-token-NAME instead of ~/.claude/oauth-token"
  fi
  echo "  -h, --help                 Show this help"
  echo
  echo "Unrecognized arguments, and everything after --, are passed to $1."
  echo "For $1's own help: agentcubicle $1 -- --help"
}

# Help is handled here, before engine detection, so it works without docker or
# podman installed. For a tool, only the arguments before -- are scanned (what
# follows belongs to the tool), skipping the values of options that take one.
if [[ $# -gt 0 ]]; then
  case "$1" in
    -h|--help|help)
      _print_usage
      exit 0
      ;;
    setup|check|commit|cleanup|list|shell|share)
      for HELP_ARG in "${@:2}"; do
        if [[ "$HELP_ARG" == -h || "$HELP_ARG" == --help ]]; then
          HELP_VAR="USAGE_$(printf %s "$1" | tr a-z A-Z)"
          echo "Usage: ${!HELP_VAR}"
          exit 0
        fi
      done
      ;;
    opencode|claude)
      HELP_SKIP=false
      for HELP_ARG in "${@:2}"; do
        if $HELP_SKIP; then
          HELP_SKIP=false
          continue
        fi
        case "$HELP_ARG" in
          --) break ;;
          -h|--help)
            _print_run_help "$1"
            exit 0
            ;;
          --name|--img|--mount|--env|--share|--share-dir|--account) HELP_SKIP=true ;;
        esac
      done
      ;;
  esac
fi

# `share` only manages host directories, so it is handled here, before engine
# detection, and works without docker or podman installed.
if [[ "${1:-}" == "share" ]]; then
  SHARE_USAGE="Usage: $USAGE_SHARE"
  case "${2:-}" in
    create)
      [[ $# -eq 3 ]] || { echo "$SHARE_USAGE" >&2; exit 1; }
      _validate_share_name "$3"
      mkdir -p "$SHARES_ROOT/$3"
      echo "Share '$3' is at $SHARES_ROOT/$3"
      echo "Enable it with: agentcubicle <opencode|claude> --share $3 (or --share $3:ro)"
      ;;
    list)
      [[ $# -eq 2 ]] || { echo "$SHARE_USAGE" >&2; exit 1; }
      FOUND_SHARE=false
      if [[ -d "$SHARES_ROOT" ]]; then
        for SHARE_DIR in "$SHARES_ROOT"/*/; do
          [[ -d "$SHARE_DIR" ]] || continue
          SHARE_DIR="${SHARE_DIR%/}"
          printf '%s\t%s\n' "${SHARE_DIR##*/}" "$SHARE_DIR"
          FOUND_SHARE=true
        done
      fi
      $FOUND_SHARE || echo "No shares under $SHARES_ROOT"
      ;;
    rm)
      [[ $# -eq 3 ]] || { echo "$SHARE_USAGE" >&2; exit 1; }
      _validate_share_name "$3"
      if [[ ! -d "$SHARES_ROOT/$3" ]]; then
        echo "Error: no share named '$3' under $SHARES_ROOT." >&2
        exit 1
      fi
      # rmdir only: the script never deletes share contents recursively.
      if [[ -n "$(ls -A "$SHARES_ROOT/$3")" ]]; then
        echo "Error: share '$3' is not empty. Delete its contents yourself first:" >&2
        echo "  $SHARES_ROOT/$3" >&2
        exit 1
      fi
      rmdir "$SHARES_ROOT/$3"
      echo "Removed share '$3'."
      ;;
    *)
      echo "$SHARE_USAGE" >&2
      exit 1
      ;;
  esac
  exit 0
fi

# Container engine: honor AGENTCUBICLE_ENGINE if set, otherwise auto-detect,
# preferring podman when both are installed.
ENGINE="${AGENTCUBICLE_ENGINE:-}"
if [[ -n "$ENGINE" ]]; then
  if ! command -v "$ENGINE" >/dev/null 2>&1; then
    echo "Error: AGENTCUBICLE_ENGINE is set to '$ENGINE' but that command was not found." >&2
    exit 1
  fi
elif command -v podman >/dev/null 2>&1; then
  ENGINE=podman
elif command -v docker >/dev/null 2>&1; then
  ENGINE=docker
else
  echo "Error: no container engine found. Install podman or docker, or set AGENTCUBICLE_ENGINE." >&2
  exit 1
fi

# podman resolves unqualified image names against registries; pin the locally
# built image to an unambiguous localhost/ reference so build, FROM, run, and
# inspect all use the local image instead of attempting a registry pull.
if [[ "$ENGINE" == podman && "$COMMIT_TARGET" != */* ]]; then
  COMMIT_TARGET="localhost/$COMMIT_TARGET"
fi

# Packages and the binary to check for them. Format: "package:binary"
# If no colon, the binary has the same name as the package.
REQUIRED_PACKAGES=(
  "bat"
  "build-base:make"
  "cgdb"
  "curl"
  "curlie"
  "diffutils:diff"
  "file"
  "fzf"
  "gcc"
  "g++"
  "gdb"
  "gdb-dashboard:gdb"
  "git"
  "htop"
  "httpie"
  "jq"
  "lua5.4"
  "luajit"
  "lsof"
  "nano"
  "netcat-openbsd:nc"
  "nmap"
  "nodejs:node"
  "npm"
  "patch"
  "perl"
  "python3"
  "py3-pip:pip3"
  "shellcheck"
  "sqlite"
  "strace"
  "tcpdump"
  "tmux"
  "tree"
  "uv:uvx"
  "valgrind"
  "vim"
  "wl-clipboard:wl-copy"
  "wrk"
  "xclip"
)

# Resolve binary name for a package entry: "pkg:bin" → bin, "pkg" → pkg
_pkg_to_bin() {
  echo "${1#*:}"
}

# Default image for `check` and run
IMAGE="$COMMIT_TARGET"

# Generate unique container name: ac-<project>-<random>
_generate_name() {
  local sanitized
  sanitized="$(basename "$WORKDIR" | sed 's/[^a-zA-Z0-9_-]/-/g')"
  local rand
  rand="$(od -An -tx1 -N4 /dev/urandom | tr -d ' \n')"
  echo "ac-${sanitized}-${rand}"
}

# Determine config home directory based on tool
_config_home() {
  if [[ "$TOOL" == "opencode" ]]; then
    echo "$HOME/.config/opencode"
  else
    echo "$HOME/.claude"
  fi
}

# Write $2 to $1 only if that path does not exist yet, so local edits made
# in a previous run are never clobbered on the next one.
_seed_if_absent() {
  local target="$1"
  local content="$2"
  [[ -f "$target" ]] || printf '%s\n' "$content" > "$target"
}

# Per-user list of extra Alpine packages to install into the image, one per
# line, in the same "pkg" or "pkg:binary" form as REQUIRED_PACKAGES. Blank
# lines and anything after a # are ignored. It lives in the host config
# directory, not in the project: .agentcubicle/ is mounted into the container,
# and these files drive root-level changes to the image, so the agent must not
# be able to edit them.
USER_CONFIG_DIR="$HOME/.config/agentcubicle"
USER_PACKAGES_FILE="$USER_CONFIG_DIR/packages"
USER_PACKAGES=()

_read_user_packages() {
  USER_PACKAGES=()
  [[ -f "$USER_PACKAGES_FILE" ]] || return 0
  local line n=0
  while IFS= read -r line || [[ -n "$line" ]]; do
    n=$((n + 1))
    line="${line%%#*}"
    line="${line#"${line%%[![:space:]]*}"}"
    line="${line%"${line##*[![:space:]]}"}"
    [[ -n "$line" ]] || continue
    if [[ "$line" =~ ^[a-zA-Z0-9][a-zA-Z0-9._+-]*(:[a-zA-Z0-9][a-zA-Z0-9._+-]*)?$ ]]; then
      USER_PACKAGES+=("$line")
    else
      echo "agentcubicle: ignoring invalid package '$line' at $USER_PACKAGES_FILE:$n" >&2
    fi
  done < "$USER_PACKAGES_FILE"
}

# Optional shell script run as root at the end of a fresh image build, for
# tools that are not Alpine packages. It is not tracked: it only runs when the
# image is built (first `setup`, or `setup --clear`), never as an update.
USER_INSTALL_FILE="$USER_CONFIG_DIR/install.sh"

# install.sh runs only when the image is built, so on an existing image it is
# skipped; say so, since a plain `setup` otherwise gives no hint.
_note_install_skipped() {
  [[ -f "$USER_INSTALL_FILE" ]] || return 0
  echo "Note: $USER_INSTALL_FILE only runs when the image is built; use 'setup --clear' to apply changes to it."
}

# Hash of the user's package names (order- and binary-independent), stored on
# the image as a label so setup can tell when the list has changed. Empty when
# there are no user packages, which matches images built before this existed.
_user_packages_hash() {
  local entry
  [[ ${#USER_PACKAGES[@]} -gt 0 ]] || return 0
  for entry in "${USER_PACKAGES[@]}"; do
    echo "${entry%%:*}"
  done | LC_ALL=C sort -u | { sha256sum 2>/dev/null || shasum -a 256; } | cut -d' ' -f1
}

# --- Phase 1: extract top-level subcommands (no tool context) ---
if [[ $# -gt 0 ]]; then
  case "$1" in
    setup|check|commit|cleanup|list|shell)
      COMMAND="$1"
      shift
      ;;
  esac
fi

# Parse `setup` flags
if [[ "$COMMAND" == "setup" ]]; then
  while [[ $# -gt 0 ]]; do
    case $1 in
      --clear)
        CLEAR=true
        shift
        ;;
      --claude)
        EXTRA_ARGS+=("--claude")
        shift
        ;;
      *)
        echo "Error: unknown argument '$1' for setup."
        echo "Usage: $USAGE_SETUP"
        exit 1
        ;;
    esac
  done
fi

# Parse `check` flags
if [[ "$COMMAND" == "check" ]]; then
  while [[ $# -gt 0 ]]; do
    case $1 in
      --img)
        IMAGE="$2"
        shift 2
        ;;
      *)
        echo "Error: unknown argument '$1' for check."
        echo "Usage: $USAGE_CHECK"
        exit 1
        ;;
    esac
  done
fi

# Parse `commit` flags
if [[ "$COMMAND" == "commit" ]]; then
  while [[ $# -gt 0 ]]; do
    case $1 in
      --name)
        CMD_NAME="$2"
        shift 2
        ;;
      *)
        echo "Error: unknown argument '$1' for commit."
        echo "Usage: $USAGE_COMMIT"
        exit 1
        ;;
    esac
  done
fi

# Parse `list` flags
if [[ "$COMMAND" == "list" ]]; then
  while [[ $# -gt 0 ]]; do
    case $1 in
      --name)
        CMD_NAME="$2"
        shift 2
        ;;
      *)
        echo "Error: unknown argument '$1' for list."
        echo "Usage: $USAGE_LIST"
        exit 1
        ;;
    esac
  done
fi

# Parse `shell` flags
if [[ "$COMMAND" == "shell" ]]; then
  while [[ $# -gt 0 ]]; do
    case $1 in
      --name)
        CMD_NAME="$2"
        shift 2
        ;;
      *)
        echo "Error: unknown argument '$1' for shell."
        echo "Usage: $USAGE_SHELL"
        exit 1
        ;;
    esac
  done
fi

# --- Phase 2: run mode — requires <opencode|claude> ---
if [[ -z "$COMMAND" ]]; then
  if [[ $# -lt 1 ]] || [[ "$1" == "--" ]]; then
    echo "Error: First argument must be 'opencode' or 'claude'."
    echo ""
    _print_usage
    exit 1
  fi

  TOOL="$1"
  shift

  if [[ "$TOOL" != "opencode" && "$TOOL" != "claude" ]]; then
    echo "Error: Unknown tool '$TOOL'. Must be 'opencode' or 'claude'."
    exit 1
  fi

  # Parse remaining arguments for run
  while [[ $# -gt 0 ]]; do
    if $PARSE_DASHDASH; then
      EXTRA_ARGS+=("$1")
      shift
      continue
    fi

    case $1 in
      --name)
        CMD_NAME="$2"
        shift 2
        ;;
      --img)
        IMAGE="$2"
        shift 2
        ;;
      --mount)
        EXTRA_MOUNTS+=("-v" "$2")
        shift 2
        ;;
      --share)
        if [[ $# -lt 2 || -z "$2" ]]; then
          echo "Error: --share needs NAME, NAME:ro or NAME:rw." >&2
          exit 1
        fi
        SHARE_NAME="${2%%:*}"
        SHARE_MODE=rw
        if [[ "$2" == *:* ]]; then
          SHARE_MODE="${2#*:}"
        fi
        if [[ "$SHARE_MODE" != ro && "$SHARE_MODE" != rw ]]; then
          echo "Error: --share mode must be ro or rw, got '$SHARE_MODE'." >&2
          exit 1
        fi
        _validate_share_name "$SHARE_NAME"
        # No auto-create: a typo should fail, not mount a fresh empty share.
        if [[ ! -d "$SHARES_ROOT/$SHARE_NAME" ]]; then
          echo "Error: no share named '$SHARE_NAME' under $SHARES_ROOT." >&2
          echo "Create it with: agentcubicle share create $SHARE_NAME" >&2
          exit 1
        fi
        _add_share_mount "$SHARES_ROOT/$SHARE_NAME" "$SHARE_NAME" "$SHARE_MODE"
        shift 2
        ;;
      --share-dir)
        if [[ $# -lt 2 || -z "$2" ]]; then
          echo "Error: --share-dir needs PATH, PATH:ro or PATH:rw." >&2
          exit 1
        fi
        # Read-only unless asked otherwise: this is typically another
        # agent's live working tree.
        SHARE_PATH="$2"
        SHARE_MODE=ro
        case "$SHARE_PATH" in
          *:ro|*:rw)
            SHARE_MODE="${SHARE_PATH##*:}"
            SHARE_PATH="${SHARE_PATH%:*}"
            ;;
        esac
        # The engine's -v syntax splits on ':' (and docker --mount on ',').
        if [[ "$SHARE_PATH" == *[:,]* || "$SHARE_PATH" == *$'\n'* ]]; then
          echo "Error: --share-dir path '$SHARE_PATH' contains ':', ',' or a newline, which the container engine cannot mount. Mode suffix must be :ro or :rw." >&2
          exit 1
        fi
        if [[ ! -d "$SHARE_PATH" ]]; then
          echo "Error: --share-dir: '$SHARE_PATH' is not a directory." >&2
          exit 1
        fi
        SHARE_PATH="$(cd "$SHARE_PATH" && pwd -P)"
        if [[ "$SHARE_PATH" == / ]]; then
          echo "Error: --share-dir cannot share /." >&2
          exit 1
        fi
        _add_share_mount "$SHARE_PATH" "${SHARE_PATH##*/}" "$SHARE_MODE"
        shift 2
        ;;
      --env)
        EXTRA_ENVS+=("-e" "$2")
        shift 2
        ;;
      --keep-container)
        KEEP_CONTAINER=true
        shift
        ;;
      --account)
        if [[ $# -lt 2 || -z "$2" ]]; then
          echo "Error: --account needs a NAME." >&2
          exit 1
        fi
        ACCOUNT="$2"
        shift 2
        ;;
      --)
        PARSE_DASHDASH=true
        shift
        ;;
      *)
        EXTRA_ARGS+=("$1")
        shift
        ;;
    esac
  done

  # --account NAME selects ~/.claude/oauth-token-NAME as the token file, for
  # running with a different Claude account than the default one. The name
  # ends up in a file name, so it is restricted to letters, digits, - and _.
  if [[ -n "$ACCOUNT" ]]; then
    if [[ "$TOOL" != "claude" ]]; then
      echo "Error: --account only applies to claude." >&2
      exit 1
    fi
    if [[ ! "$ACCOUNT" =~ ^[A-Za-z0-9_-]+$ ]]; then
      echo "Error: --account name must only contain letters, digits, '-' and '_'." >&2
      exit 1
    fi
  fi
fi
CLAUDE_TOKEN_FILE="$HOME/.claude/oauth-token${ACCOUNT:+-$ACCOUNT}"

# --- subcommand handlers ---

# -- setup: build custom image with dev tools and clipboard --
if [[ "$COMMAND" == "setup" ]]; then
  INSTALL_CLAUDE=false
  for arg in "${EXTRA_ARGS[@]+"${EXTRA_ARGS[@]}"}"; do
    if [[ "$arg" == "--claude" ]]; then
      INSTALL_CLAUDE=true
    fi
  done

  # Remove existing image first if --clear is set
  if $CLEAR; then
    $ENGINE image rm -f "$COMMIT_TARGET" >/dev/null 2>/dev/null || true
  fi

  NO_CACHE_ARGS=()
  if $CLEAR; then
    NO_CACHE_ARGS=(--no-cache)
  fi

  NEEDS_BASE=false
  NEEDS_CLAUDE=false
  NEEDS_USER_PKGS=false
  HAS_CLAUDE=false

  _read_user_packages
  USER_PKGS_HASH="$(_user_packages_hash)"

  if $ENGINE image inspect "$COMMIT_TARGET" >/dev/null 2>&1; then
    if $ENGINE run --entrypoint sh --rm "$COMMIT_TARGET" -c "test -x /home/user/.local/bin/claude" 2>/dev/null; then
      HAS_CLAUDE=true
    fi

    IMAGE_PKGS_HASH="$($ENGINE image inspect -f '{{index .Config.Labels "agentcubicle.user-packages"}}' "$COMMIT_TARGET" 2>/dev/null || true)"
    if [[ "$IMAGE_PKGS_HASH" == "<no value>" ]]; then
      IMAGE_PKGS_HASH=""
    fi
    if [[ "$IMAGE_PKGS_HASH" != "$USER_PKGS_HASH" ]]; then
      NEEDS_USER_PKGS=true
    fi

    if $INSTALL_CLAUDE && ! $HAS_CLAUDE; then
      NEEDS_CLAUDE=true
    elif ! $INSTALL_CLAUDE && ! $NEEDS_USER_PKGS; then
      echo "Image $COMMIT_TARGET is ready."
      if $HAS_CLAUDE; then
        echo "Claude Code is also installed."
      fi
      _note_install_skipped
      exit 0
    fi
  else
    NEEDS_BASE=true
  fi

  PKG_NAMES=()
  for entry in "${REQUIRED_PACKAGES[@]}"; do
    PKG_NAMES+=("${entry%%:*}")
  done
  USER_PKG_NAMES=()
  for entry in ${USER_PACKAGES[@]+"${USER_PACKAGES[@]}"}; do
    USER_PKG_NAMES+=("${entry%%:*}")
  done

  _user_pkgs_hint() {
    if [[ ${#USER_PKG_NAMES[@]} -gt 0 ]]; then
      echo "agentcubicle: if a package from $USER_PACKAGES_FILE is the cause, check its name (Alpine packages only)." >&2
    fi
    if [[ -n "$USER_INSTALL_B64" ]]; then
      echo "agentcubicle: if $USER_INSTALL_FILE is the cause, see its traced output above (it runs as root, with sh -eux)." >&2
    fi
  }

  # Build base + optionally claude in one go
  BUILD_CLAUDE=false
  if $NEEDS_BASE && $INSTALL_CLAUDE; then
    BUILD_CLAUDE=true
  fi

  USER_INSTALL_B64=""
  if $NEEDS_BASE && [[ -f "$USER_INSTALL_FILE" ]]; then
    USER_INSTALL_B64="$(base64 < "$USER_INSTALL_FILE" | tr -d '\n')"
  fi

  if $NEEDS_BASE; then
    echo "Building $COMMIT_TARGET with dev tools ..."
    if ! $ENGINE build ${NO_CACHE_ARGS[@]+"${NO_CACHE_ARGS[@]}"} --build-arg PACKAGES="${PKG_NAMES[*]} ${USER_PKG_NAMES[*]:-}" --build-arg INSTALL_CLAUDE="$BUILD_CLAUDE" --build-arg USER_INSTALL_B64="$USER_INSTALL_B64" --label "agentcubicle.user-packages=$USER_PKGS_HASH" -t "$COMMIT_TARGET" - < <(
      cat <<'EOF'
FROM ghcr.io/anomalyco/opencode
ARG PACKAGES
ARG INSTALL_CLAUDE
ARG USER_INSTALL_B64
RUN apk add --no-cache $PACKAGES bash libgcc libstdc++ ripgrep shadow
RUN addgroup -g 1000 user 2>/dev/null || true
RUN adduser -u 1000 -G user -D -h /home/user user 2>/dev/null || true
RUN mkdir -p /usr/local/bin
ENV PATH="/usr/local/bin:$PATH"
ENV USE_BUILTIN_RIPGREP=0
RUN set -eux; for i in 1 2 3; do ghver="$(curl -fsSL --max-time 30 https://api.github.com/repos/cli/cli/releases/latest | sed -n 's/.*"tag_name": *"\([^"]*\)".*/\1/p' | head -n1)" && [ -n "$ghver" ] && break; sleep 5; done; case "$(uname -m)" in x86_64) gharch=amd64 ;; aarch64|arm64) gharch=arm64 ;; *) echo "agentcubicle: unsupported architecture $(uname -m) for the GitHub CLI" >/dev/stderr; exit 1 ;; esac; curl -fsSL --max-time 120 -o /tmp/gh.tgz "https://github.com/cli/cli/releases/download/${ghver}/gh_${ghver#v}_linux_${gharch}.tar.gz"; tar -xzf /tmp/gh.tgz -C /tmp; install -m 0755 "/tmp/gh_${ghver#v}_linux_${gharch}/bin/gh" /usr/local/bin/gh; rm -rf /tmp/gh.tgz "/tmp/gh_${ghver#v}_linux_${gharch}"; gh --version
RUN if [ "$INSTALL_CLAUDE" = "true" ]; then su -s /bin/sh user -c 'export PATH="/home/user/.local/bin:$PATH" USE_BUILTIN_RIPGREP=0; curl -fsSL https://claude.ai/install.sh | bash'; fi
RUN if [ -n "$USER_INSTALL_B64" ]; then echo "$USER_INSTALL_B64" | base64 -d > /tmp/user-install.sh && sh -eux /tmp/user-install.sh && rm -f /tmp/user-install.sh; fi
EOF
    ); then
      _user_pkgs_hint
      exit 1
    fi
    echo "Done. Image '$COMMIT_TARGET' is ready."
  elif $NEEDS_USER_PKGS; then
    # The image exists but the user's package list changed since it was built:
    # install the current list on top instead of rebuilding everything. A
    # removed package stays installed until `setup --clear`.
    echo "Updating user packages in $COMMIT_TARGET ..."
    USER_PKGS_RUN=""
    if [[ ${#USER_PKG_NAMES[@]} -gt 0 ]]; then
      USER_PKGS_RUN="RUN apk add --no-cache ${USER_PKG_NAMES[*]}"
    fi
    if ! $ENGINE build -t "$COMMIT_TARGET" - < <(
      cat <<EOF
FROM $COMMIT_TARGET
$USER_PKGS_RUN
LABEL agentcubicle.user-packages="$USER_PKGS_HASH"
EOF
    ); then
      _user_pkgs_hint
      exit 1
    fi
    echo "Done. User packages are up to date."
  fi

  # If image existed but lacks claude, add it on top
  if $NEEDS_CLAUDE; then
    echo "Adding claude to $COMMIT_TARGET ..."
    $ENGINE build ${NO_CACHE_ARGS[@]+"${NO_CACHE_ARGS[@]}"} -t "$COMMIT_TARGET" - < <(
       cat <<EOF
FROM $COMMIT_TARGET
RUN apk add --no-cache shadow
RUN addgroup -g 1000 user 2>/dev/null || true; adduser -u 1000 -G user -D -h /home/user user 2>/dev/null || true
RUN mkdir -p /usr/local/bin
ENV PATH="/usr/local/bin:\$PATH"
ENV USE_BUILTIN_RIPGREP=0
RUN su -s /bin/sh user -c 'export PATH="/home/user/.local/bin:\$PATH" USE_BUILTIN_RIPGREP=0; curl -fsSL https://claude.ai/install.sh | bash'
EOF
    )
    echo "Done. Claude Code is installed."
  else
    echo "Image $COMMIT_TARGET is ready."
    if $HAS_CLAUDE; then
      echo "Claude Code is already installed."
    fi
  fi

  # The image existed and was only updated on top (user packages and/or
  # Claude): install.sh did not run.
  if ! $NEEDS_BASE; then
    _note_install_skipped
  fi

  exit 0
fi

# -- check: inspect image for required tools --
if [[ "$COMMAND" == "check" ]]; then
  # A --img override may be unqualified; pin it to localhost/ under podman.
  if [[ "$ENGINE" == podman && "$IMAGE" != */* ]]; then
    IMAGE="localhost/$IMAGE"
  fi
  _ok() { echo "  ✓ $1"; }
  _missing() { echo "  ✗ $1 (missing)"; }

  echo "Checking image '$IMAGE' ..."
  MISSING=0

  for entry in "${REQUIRED_PACKAGES[@]}"; do
    PKG="${entry%%:*}"
    BIN="$(_pkg_to_bin "$entry")"
    if $ENGINE run --entrypoint sh --rm "$IMAGE" -c "command -v $BIN >/dev/null" 2>/dev/null; then
      _ok "$PKG"
    else
      _missing "$PKG"
      MISSING=1
    fi
  done

  # User packages with no ":binary" part may not ship an executable at all
  # (libraries, headers), so those are checked with apk instead of PATH.
  _read_user_packages
  for entry in ${USER_PACKAGES[@]+"${USER_PACKAGES[@]}"}; do
    PKG="${entry%%:*}"
    if [[ "$entry" == *:* ]]; then
      CHECK_CMD="command -v ${entry#*:} >/dev/null"
    else
      CHECK_CMD="apk info -e $PKG >/dev/null"
    fi
    if $ENGINE run --entrypoint sh --rm "$IMAGE" -c "$CHECK_CMD" 2>/dev/null; then
      _ok "$PKG (user)"
    else
      _missing "$PKG (user)"
      MISSING=1
    fi
  done

  # The three tools that do not come from apk are reported with their
  # version, not just a tick: their in-container auto-updaters are off (see
  # README "Tool versions in the container"), so whatever the image was built
  # with is what runs, and these lines are how a stale image gets noticed.
  # Empty output means the probe failed, i.e. the tool is missing. The probe's
  # failure status must not escape: under pipefail it would fail the caller's
  # assignment, and set -e would end check right there (exit 127 when the
  # tool is not in the image).
  _version() { $ENGINE run --entrypoint sh --rm "$IMAGE" -c "$1" 2>/dev/null | head -n1 || true; }

  # gh has no apk package, so it is not in REQUIRED_PACKAGES; it is installed
  # from a release tarball to /usr/local/bin/gh (on PATH), checked like claude.
  # `gh --version` prints `gh version X.Y.Z (date)`.
  GH_VERSION="$(_version 'gh --version' | awk '{print $3}')"
  if [[ -n "$GH_VERSION" ]]; then
    _ok "gh ($GH_VERSION)"
  else
    _missing "gh"
    MISSING=1
  fi

  # claude is installed to /home/user/.local/bin/claude, by and for the
  # unprivileged user, so probe it as that user (same su form the build uses)
  # rather than as the container root this runs as. `claude --version` prints
  # `X.Y.Z (Claude Code)`.
  CLAUDE_VERSION="$(_version 'su -s /bin/sh user -c "/home/user/.local/bin/claude --version"' | awk '{print $1}')"
  if [[ -n "$CLAUDE_VERSION" ]]; then
    _ok "claude ($CLAUDE_VERSION)"
  else
    _missing "claude"
    MISSING=1
  fi

  # opencode comes from the base image, so `setup` can neither install nor
  # refresh it on its own: report the version and never fail the check on it,
  # which would only point at a subcommand that cannot help.
  OPENCODE_VERSION="$(_version 'opencode --version' | awk '{print $1}')"
  if [[ -n "$OPENCODE_VERSION" ]]; then
    _ok "opencode ($OPENCODE_VERSION)"
  else
    echo "  - opencode (version not reported)"
  fi

  if [[ "$MISSING" -eq 1 ]]; then
    echo ""
    echo "Run 'agentcubicle setup' to install missing tools into $COMMIT_TARGET."
  fi
  exit 0
fi

# -- cleanup --
if [[ "$COMMAND" == "cleanup" ]]; then
  for cid in $($ENGINE ps -a --filter 'name=^ac-' --filter 'status=exited' --format '{{.ID}}' 2>/dev/null || true); do
    $ENGINE rm "$cid"
  done
  exit 0
fi

# -- list --
if [[ "$COMMAND" == "list" ]]; then
  if [[ -n "$CMD_NAME" ]]; then
    $ENGINE ps -a --filter "name=$CMD_NAME" --format 'table {{.Status}}\t{{.Names}}\t{{.Image}}\t{{.CreatedAt}}' 2>/dev/null || true
  else
    $ENGINE ps -a --filter 'name=^ac-' --format 'table {{.Status}}\t{{.Names}}\t{{.Image}}\t{{.CreatedAt}}' 2>/dev/null || true
  fi
  exit 0
fi

# -- shell --
if [[ "$COMMAND" == "shell" ]]; then
  if [[ -n "$CMD_NAME" ]]; then
    $ENGINE inspect "$CMD_NAME" >/dev/null 2>&1 || { echo "Error: container '$CMD_NAME' not found."; exit 1; }
    RUNNING=$($ENGINE inspect -f '{{.State.Running}}' "$CMD_NAME" 2>/dev/null || true)
    if [[ "$RUNNING" != "true" ]]; then
      echo "Error: container '$CMD_NAME' is not running. Use 'list' to see containers."
      exit 1
    fi
    $ENGINE exec -it "$CMD_NAME" sh
    exit 0
  fi

  CONTAINERS=$($ENGINE ps --filter 'name=^ac-' --format '{{.Names}}' 2>/dev/null || true)
  if [[ -z "$CONTAINERS" ]]; then
    echo "No running containers prefixed with 'ac-' found."
    exit 1
  fi

  echo "Running containers:"
  IDX=1
  NAMES=()
  while IFS= read -r name; do
    [[ -z "$name" ]] && continue
    NAMES+=("$name")
    echo "  ${IDX}) ${name}"
    IDX=$((IDX + 1))
  done <<< "$CONTAINERS"

  if [[ ! -t 0 ]]; then
    echo "Error: no tty available. Use --name to specify a container (not interactive)."
    exit 1
  fi

  echo -n "Pick a container [1]: "
  read -r REPLY_CHOICE
  CHOICE="${REPLY_CHOICE:-1}"

  if ! [[ "$CHOICE" =~ ^[0-9]+$ ]] || [[ "$CHOICE" -lt 1 || "$CHOICE" -gt "${#NAMES[@]}" ]]; then
    echo "Invalid choice."
    exit 1
  fi

  $ENGINE exec -it "${NAMES[$((CHOICE - 1))]}" sh
  exit 0
fi

# -- commit --
if [[ "$COMMAND" == "commit" ]]; then
  if [[ -n "$CMD_NAME" ]]; then
    $ENGINE commit "$CMD_NAME" "$COMMIT_TARGET"
    exit 0
  fi

  # List running ac-* containers
  CONTAINERS=$($ENGINE ps --filter 'name=^ac-' --format '{{.Names}}' 2>/dev/null || true)
  if [[ -z "$CONTAINERS" ]]; then
    echo "No running containers prefixed with 'ac-' found."
    exit 1
  fi

  echo "Running containers:"
  IDX=1
  NAMES=()
  while IFS= read -r name; do
    [[ -z "$name" ]] && continue
    NAMES+=("$name")
    echo "  ${IDX}) ${name}"
    IDX=$((IDX + 1))
  done <<< "$CONTAINERS"

  if [[ ! -t 0 ]]; then
    echo "Error: no tty available. Use --name to specify a container (not interactive)."
    exit 1
  fi

  echo -n "Pick a container [1]: "
  read -r REPLY_CHOICE
  CHOICE="${REPLY_CHOICE:-1}"

  if ! [[ "$CHOICE" =~ ^[0-9]+$ ]] || [[ "$CHOICE" -lt 1 || "$CHOICE" -gt "${#NAMES[@]}" ]]; then
    echo "Invalid choice."
    exit 1
  fi

  $ENGINE commit "${NAMES[$((CHOICE - 1))]}" "$COMMIT_TARGET"
  exit 0
fi

# --- Normal mode: start a container ---
# A --img override may be unqualified; pin it to localhost/ under podman too so
# run and inspect use the local image instead of a registry short-name lookup.
if [[ "$ENGINE" == podman && "$IMAGE" != */* ]]; then
  IMAGE="localhost/$IMAGE"
fi
if ! $ENGINE image inspect "$IMAGE" >/dev/null 2>&1; then
  echo "Error: $IMAGE image not found."
  if [[ "$IMAGE" == "$COMMIT_TARGET" ]]; then
    echo "Run 'agentcubicle setup' first."
  fi
  exit 1
fi

CONTAINER_NAME="${CMD_NAME:-$(_generate_name)}"

# Remove only if a name was explicitly provided (re-use same name)
if [[ -n "$CMD_NAME" ]]; then
  $ENGINE rm -f "$CONTAINER_NAME" 2>/dev/null || true
fi

CONFIG_HOME="$(_config_home)"
DOCKER_CONFIG_ROOT="${CONFIG_HOME#"$HOME"}"

# Auto-redact literal API keys from the host opencode config. If a
# provider's options.apiKey is a literal value (not a {env:...} or
# {file:...} reference), forward the real value into the container as a
# generated env var and feed the container a redacted copy of the config
# that references {env:NAME} instead — so the literal key never lands in
# the container's writable config copy (or a `docker commit` of it), and a
# user who keeps a literal key in their own config needn't hand-convert it
# to the {env:VAR} shape. Only attempted when jq can parse the file; a
# .jsonc with comments is left untouched for the plain mount+copy path.
OPENCODE_REDACTED_B64=""
OPENCODE_REDACTED_BASENAME=""
if [[ "$TOOL" == "opencode" ]]; then
  for cfg in "$CONFIG_HOME/opencode.json" "$CONFIG_HOME/opencode.jsonc"; do
    [[ -f "$cfg" ]] || continue
    jq -e . "$cfg" >/dev/null 2>&1 || break
    redacted="$(cat "$cfg")"
    while IFS= read -r prov; do
      [[ -z "$prov" ]] && continue
      var="AC_OPENCODE_$(printf '%s' "$prov" | tr '[:lower:]' '[:upper:]' | tr -c 'A-Z0-9' '_')_APIKEY"
      val="$(printf '%s' "$redacted" | jq -r --arg p "$prov" '.provider[$p].options.apiKey')"
      EXTRA_ENVS+=("-e" "$var=$val")
      redacted="$(printf '%s' "$redacted" | jq --arg p "$prov" --arg v "$var" '.provider[$p].options.apiKey = "{env:" + $v + "}"')"
    done < <(jq -r '.provider // {} | to_entries[]
                    | select((.value.options.apiKey? | type) == "string")
                    | select((.value.options.apiKey | test("^\\{(env|file):[^}]*\\}$")) | not)
                    | .key' "$cfg")
    if [[ "$redacted" != "$(cat "$cfg")" ]]; then
      OPENCODE_REDACTED_B64="$(printf '%s' "$redacted" | base64 -w0)"
      OPENCODE_REDACTED_BASENAME="$(basename "$cfg")"
    fi
    break
  done
fi

# For claude, mount only settings.json (the one file the entrypoint ever
# reads from here) rather than the whole ~/.claude directory, so the
# oauth-token file (and the raw .credentials.json) never enter the
# container's mount namespace at all - the oauth token is already forwarded
# separately as an env var below. Guarded on existence: bind-mounting a
# single file that does not yet exist on the host causes Docker to create
# an empty directory there instead, which would corrupt a future
# `claude setup-token` save.
CONFIG_HOME_MOUNT_ARGS=()
if [[ "$ENGINE" == podman ]]; then
  # podman runs as the unprivileged user, which cannot read /root, so config is
  # staged under a user-readable path for the entrypoint to copy into place.
  if [[ "$TOOL" == "claude" ]]; then
    if [[ -f "$CONFIG_HOME/settings.json" ]]; then
      CONFIG_HOME_MOUNT_ARGS=(-v "$CONFIG_HOME/settings.json:/home/user/.config-host/claude/settings.json:ro")
    fi
  elif [[ -z "$OPENCODE_REDACTED_B64" && -d "$CONFIG_HOME" ]]; then
    CONFIG_HOME_MOUNT_ARGS=(-v "$CONFIG_HOME:/home/user/.config-host/opencode:ro")
  fi
elif [[ "$TOOL" == "claude" ]]; then
  if [[ -f "$CONFIG_HOME/settings.json" ]]; then
    CONFIG_HOME_MOUNT_ARGS=(-v "$CONFIG_HOME/settings.json:/root/.claude/settings.json:ro")
  fi
elif [[ -z "$OPENCODE_REDACTED_B64" ]]; then
  # opencode without redaction: mount the host config dir read-only as the
  # copy source. When redaction applies, the config is injected via
  # OPENCODE_REDACTED_B64 instead, so the raw file (literal key and all)
  # never enters the container's mount namespace either.
  CONFIG_HOME_MOUNT_ARGS=(-v "$CONFIG_HOME:/root${DOCKER_CONFIG_ROOT}:ro")
fi

# Host settings.json keys that are re-read from the host and written into the
# container's persisted copy on *every* run, overwriting whatever is there.
# The rest of that file is seeded once and then owned by the container (see the
# entrypoints below), which is what per-container state needs; these keys are
# the opposite case, host-owned presentation settings the user expects to edit
# in one place. Add a key here to make it always follow the host, and a `case`
# arm below if it needs validating first.
CLAUDE_PROPAGATE_KEYS=(statusLine)
CLAUDE_PROPAGATE_JSON='{}'
# Applied to the host file during the one-time seed only, so a key we refuse to
# propagate does not sneak into a fresh container through the seed copy instead.
CLAUDE_SEED_STRIP_JQ='.'
if [[ "$TOOL" == "claude" && -f "$CONFIG_HOME/settings.json" ]]; then
  for _key in "${CLAUDE_PROPAGATE_KEYS[@]}"; do
    _value="$(jq -c --arg k "$_key" '.[$k] // empty' "$CONFIG_HOME/settings.json" 2>/dev/null)" || _value=""
    [[ -n "$_value" ]] || continue
    _skip_reason=""
    case "$_key" in
      statusLine)
        # Only an inline command can work in the container: a command that is
        # a path to a script on the host is not there. The first token decides.
        _cmd="$(printf '%s' "$_value" | jq -r 'select(type == "object" and .type == "command") | .command // empty' 2>/dev/null)" || _cmd=""
        _first="${_cmd%%[[:space:]]*}"
        if [[ -z "$_cmd" ]]; then
          _skip_reason="it is not a command statusLine"
        elif [[ "$_first" == */* || "$_first" == "~"* ]]; then
          _skip_reason="it runs $_first, which does not exist in the container. Use an inline command instead."
        fi
        ;;
    esac
    if [[ -n "$_skip_reason" ]]; then
      echo "agentcubicle: not propagating $_key from the host settings.json: $_skip_reason" >&2
      CLAUDE_SEED_STRIP_JQ="$CLAUDE_SEED_STRIP_JQ | del(.[\"$_key\"])"
      continue
    fi
    CLAUDE_PROPAGATE_JSON="$(printf '%s' "$CLAUDE_PROPAGATE_JSON" | jq -c --arg k "$_key" --argjson v "$_value" '.[$k] = $v')"
  done
fi
CLAUDE_PROPAGATE_B64="$(printf '%s' "$CLAUDE_PROPAGATE_JSON" | base64 -w0)"

# Whether the host's opencode config defines any real providers, as
# opposed to relying solely on opencode's built-in free fallback models.
# Tries jq first (handles plain JSON correctly, including a present-but-
# empty "provider": {}); falls back to a flattened-then-grepped heuristic
# for .jsonc files with comments, which jq cannot parse.
OPENCODE_HAS_PROVIDER=false
if [[ "$TOOL" == "opencode" ]]; then
  for cfg in "$CONFIG_HOME/opencode.json" "$CONFIG_HOME/opencode.jsonc"; do
    [[ -f "$cfg" ]] || continue
    if PROVIDER_COUNT=$(jq -r '.provider // {} | length' "$cfg" 2>/dev/null); then
      [[ "$PROVIDER_COUNT" -gt 0 ]] && OPENCODE_HAS_PROVIDER=true
    elif tr -d '\n\r' < "$cfg" | grep -q '"provider"[[:space:]]*:[[:space:]]*{[[:space:]]*[^[:space:]}]'; then
      OPENCODE_HAS_PROVIDER=true
    fi
  done
fi

# Container-only opencode config override (never touches host config), sent
# via OPENCODE_CONFIG_CONTENT below. Three things live in it:
# - A blanket permission allow. Combined with --agent plan below, this makes
#   plan mode best-effort rather than a hard guarantee: opencode's own
#   plan-agent rules deny edits, but this blanket allow is appended after
#   them in the resolved rule list, so it can win. Accepted trade-off; see
#   README "Permissions" for detail.
# - An `instructions` entry pointing at the local AGENTS.local.md/MEMORY.local.md
#   pair (see the .agentcubicle/ block below) — confirmed empirically that
#   opencode merges `instructions` from OPENCODE_CONFIG_CONTENT with any
#   file-based config's own `instructions` array rather than replacing it,
#   so this is purely additive even when the project has its own AGENTS.md.
# - `autoupdate: false`. opencode lives at /usr/local/bin/opencode, owned by
#   root, so the unprivileged user it runs as cannot replace it anyway; and
#   the container is removed on exit, so an update that did land would be
#   discarded. Tools are refreshed by rebuilding the image on the host (see
#   README "Tool versions in the container"). Confirmed empirically that this
#   key in OPENCODE_CONFIG_CONTENT wins over a file-based config setting it
#   to true.
OPENCODE_CONFIG_JSON=$(jq -nc --arg dir "$CONTAINER_PROJECT_DIR" \
  '{"autoupdate":false,"permission":{"*":"allow"},"instructions":[$dir + "/.agentcubicle/AGENTS.local.md", $dir + "/.agentcubicle/MEMORY.local.md"]}')

# Forward a safe, curated subset of the host's global git config (identity +
# a few UX settings) into the container. Allowlist, not blocklist, so we never
# have to guess what's dangerous: credential helpers, GPG/commit-signing keys,
# and any path-valued settings (core.excludesfile, core.hooksPath, ...) are
# simply never considered, since they'd either hang/fail (helpers, signing
# without a key) or require mounting host files outside the project directory.
GIT_ALLOWLIST=(user.name user.email init.defaultBranch pull.rebase push.default push.autoSetupRemote core.editor color.ui rerere.enabled merge.conflictstyle)
TMP_GITCONFIG="$(mktemp)"
for key in "${GIT_ALLOWLIST[@]}"; do
  val="$(git config --global --get "$key" 2>/dev/null || true)"
  [[ -n "$val" ]] && git config --file "$TMP_GITCONFIG" "$key" "$val"
done
# --null: NUL-separates each key/value record and preserves embedded
# newlines in the value literally (git's own default line-based output
# would truncate a multi-line shell-function alias at its first newline).
while IFS= read -r -d '' entry; do
  [[ -z "$entry" ]] && continue
  key="${entry%%$'\n'*}"
  val="${entry#*$'\n'}"
  git config --file "$TMP_GITCONFIG" "$key" "$val"
done < <(git config --global --get-regexp --null '^alias\.' 2>/dev/null || true)
HOST_GITCONFIG_B64=""
if [[ -s "$TMP_GITCONFIG" ]]; then
  HOST_GITCONFIG_B64="$(base64 -w0 < "$TMP_GITCONFIG")"
fi
rm -f "$TMP_GITCONFIG"

# Local, persistent, git-excluded agent rules + memory, read by both tools
# additively (even when the project already has its own tracked AGENTS.md/
# CLAUDE.md). Deliberately never placed at the literal AGENTS.md/CLAUDE.md
# paths: even a git-excluded symlink there is dangerous — if the upstream
# remote later adds a real tracked file at that exact path, git refuses to
# silently overwrite an existing untracked/excluded file during a merge or
# pull ("untracked working tree file would be overwritten"), so it would
# actively break the next `git pull`. `.git/info/exclude` only suppresses
# `git status`/`git add` discovery; it does not grant git permission to
# clobber a colliding path during merge.
#
# The files are suffixed `.local.md` (matching the CLAUDE.local.md root
# symlink) so they read unambiguously as agentcubicle-managed rather than
# colliding with a bare AGENTS.md/CLAUDE.md/MEMORY.md the project might track.
mkdir -p "$WORKDIR/.agentcubicle"

# One-time transition for projects seeded by an earlier version, which used
# the bare names. Auto-rename any legacy files to their .local.md counterpart:
# lossless, idempotent, and silent apart from a single notice. Runs before the
# seed step so seeding can't create fresh files next to orphaned legacy ones.
# Only moves when the new name is absent, so a hand-made .local.md is never
# clobbered.
_migrated=0
for _pair in "AGENTS.md:AGENTS.local.md" "CLAUDE.md:CLAUDE.local.md" "MEMORY.md:MEMORY.local.md"; do
  _old="$WORKDIR/.agentcubicle/${_pair%%:*}"
  _new="$WORKDIR/.agentcubicle/${_pair##*:}"
  if [[ -f "$_old" && ! -e "$_new" ]]; then
    mv "$_old" "$_new"
    _migrated=1
    # The CLAUDE file's `@` imports resolve relative to .agentcubicle/, so the
    # bare-name imports would now dangle — rewrite just those two directives
    # (any user prose is left untouched).
    if [[ "$_new" == */CLAUDE.local.md ]]; then
      sed -i -e 's/^@AGENTS\.md$/@AGENTS.local.md/' \
             -e 's/^@MEMORY\.md$/@MEMORY.local.md/' "$_new"
    fi
  fi
done
# Repoint the root symlink if it still targets the old CLAUDE.md; the creation
# guard further down only fires when nothing is present at the path, so it
# won't fix an existing symlink. Only our own symlink to the old target is
# touched — never a real file the user may have placed there.
if [[ -L "$WORKDIR/CLAUDE.local.md" && "$(readlink "$WORKDIR/CLAUDE.local.md")" == ".agentcubicle/CLAUDE.md" ]]; then
  ln -sfn .agentcubicle/CLAUDE.local.md "$WORKDIR/CLAUDE.local.md"
fi
[[ "$_migrated" == 1 ]] && echo "agentcubicle: migrated .agentcubicle/ files to the .local.md naming convention"

AGENTS_CONTENT=$(cat <<'AGENTS_EOF'
# AGENTS.local.md (agentcubicle local file)

> Local-only, machine-specific file maintained by `agentcubicle` at
> `.agentcubicle/AGENTS.local.md`, loaded automatically by whichever coding agent
> is running (mechanism varies by tool; see README.md if you are a human
> curious how), *in addition to* any `AGENTS.md` the project itself tracks,
> never as a replacement. Nothing here is ever committed, tracked, or
> shared with anyone who clones the repo.
>
> The name of this file is `AGENTS.local.md`, and it is not the same file as
> a bare `AGENTS.md`. Where the rules below mention `AGENTS.md`, `CLAUDE.md`
> or `MEMORY.md` without the `.local` part, they mean some other file, and
> the distinction is the point of the name. Call this one by its full name
> when you refer to it, and never write to `AGENTS.md` meaning this file:
> a root `AGENTS.md` is tracked in git and shared with everyone who clones,
> which is exactly what this file is designed not to be.

## Rules

General, tool-agnostic agent rules and conventions for this project go
here. A few sensible defaults to start with:

- Never push to a remote, or suggest pushing (e.g. offering "push to
  origin" as a follow-up after a commit). This container's workflow is
  commit-only: pushing happens on the host, by the user, after
  reviewing what was committed.
- Prefer separate commits for logically distinct changes. Distinct
  changes, not code versus prose: the documentation describing a change
  (README, design docs, comments) goes in the same commit as the change
  itself, so it can be reviewed and reverted as one unit. Splitting it
  out is a habit to resist, not tidiness.
- When a local, non-shared file needs to be kept out of a repo's history,
  use `.git/info/exclude`, never `.gitignore` (a `.gitignore` entry is
  tracked and leaks your tooling choices to anyone who clones).
- No `Co-Authored-By` trailer is forced by the container — that's left as a
  host-side, user-level preference.

## Updating the rules

When updating agent rules, select the appropriate destination:

* If the instructions are specific to the agentcubicle container context: `.agentcubicle/AGENTS.local.md`.
* If not:
  * If a git-tracked `AGENTS.md` exists at the project level (the project's
    own shared file, not this one), ask the user where to put the instructions.
  * Else `.agentcubicle/AGENTS.local.md`.

## Memory

Three places for information to live, each with a different purpose and
lifetime — know which one something belongs in:

- **`.agentcubicle/MEMORY.local.md`** is temporary work memory, not permanent
  documentation. It exists purely for continuity across sessions and
  should hold only:
  - **Current focus**: what's being worked on right now, if anything.
  - **Recent decisions**: choices made recently and their reasoning, so
    they aren't re-litigated next session — until captured permanently
    elsewhere or no longer relevant.
  - **Open threads**: questions, TODOs, or half-finished work to pick
    back up.
  Update it as you go, not just at the end of a session.
- **`README.md`** is user-facing documentation: how to use this project,
  what it does, configuration, behavior a user needs to know.
- **`docs/DESIGN.md`** (and any `docs/DESIGN/*.md` files it references)
  holds design rationale and architecture decisions — the durable "why"
  behind non-obvious choices, git-tracked and permanent, rather than
  buried in commit messages or lost the next time MEMORY.local.md gets
  cleaned up. If the project already has its own established design-doc
  convention (an `ARCHITECTURE.md`, `docs/adr/`, etc.), use that instead
  of introducing a new location — ask the user if it's unclear which to
  prefer. If neither `docs/DESIGN.md` nor an equivalent exists, **ask the
  user before creating it** — do not create it unilaterally. `docs/` may
  already serve some other, unrelated purpose in this particular
  project (a docs site, API reference, etc.), so its absence or a
  differently-used `docs/` is a real signal to check, not just proceed.

Avoid creating memory files that the running tool does not load on its own
(opencode reads the files in its `instructions` list; Claude Code follows
the `@` imports in `CLAUDE.local.md`). `.agentcubicle/MEMORY.local.md` is
the designated place for continuity across sessions. If you need dedicated
memory files beyond that, state their full path, relative to the repo root,
in `.agentcubicle/MEMORY.local.md` so the agent can find them, and prefer
`.agentcubicle/memories/` as their location. This does not apply to a
memory directory a tool manages and loads itself (Claude Code keeps one at
`.agentcubicle/claude-home/projects/<encoded-path>/memory/`, indexed by a
`MEMORY.md` inside that directory, which is a different file from
`.agentcubicle/MEMORY.local.md`): leave those where the tool puts them.

Clean up MEMORY.local.md regularly, not just when it gets unwieldy: once
something is captured permanently in README.md or the design docs, or is
resolved/no longer relevant, trim or compress it out rather than letting
it accumulate indefinitely. When unsure whether to delete or keep,
condense to a one-line summary instead of deleting outright.

Regularly — not only when explicitly asked — look back over what has
stacked up in MEMORY.local.md and in recent git history, and use it to update
README.md and the design docs with anything that deserves to live there
permanently. Then clean up MEMORY.local.md accordingly.
AGENTS_EOF
)
_seed_if_absent "$WORKDIR/.agentcubicle/AGENTS.local.md" "$AGENTS_CONTENT"

MEMORY_CONTENT=$(cat <<'MEMORY_EOF'
# MEMORY.local.md (agentcubicle local file)

> Local-only, machine-specific continuity notes maintained by
> `agentcubicle` at `.agentcubicle/MEMORY.local.md`, imported into
> `.agentcubicle/CLAUDE.local.md` (via an `@` include) and read by opencode
> directly via its own `instructions` config entry. Keep this updated
> across sessions as a lightweight, tool-agnostic memory of where things
> stand — update it as you go, not just at the end of a session. Nothing
> here is ever committed, tracked, or shared with anyone who clones the
> repo.

- **Current focus:** what's being worked on right now.
- **Recent decisions:** choices made and the reasoning, so they aren't
  re-litigated next session.
- **Open threads:** questions, TODOs, or half-finished work to pick back up.
MEMORY_EOF
)
_seed_if_absent "$WORKDIR/.agentcubicle/MEMORY.local.md" "$MEMORY_CONTENT"

CLAUDE_CONTENT=$(cat <<'CLAUDE_EOF'
# CLAUDE.local.md (agentcubicle local file, Claude-Code-specific)

> Local-only, machine-specific file maintained by `agentcubicle` at
> `.agentcubicle/CLAUDE.local.md`, exposed at the project root as `CLAUDE.local.md`
> (a symlink). Claude Code loads `CLAUDE.local.md` automatically every
> session. Nothing here is ever committed, tracked, or shared with anyone
> who clones the repo.
>
> Keep ONLY Claude-Code-specific instructions here — things that genuinely
> don't apply to opencode or other tools. Everything else belongs in
> `.agentcubicle/AGENTS.local.md` (general rules) or `.agentcubicle/MEMORY.local.md`
> (working notes). Their content is inlined below via `@` imports, so you
> already have it without needing a separate read — do not re-read either
> file with a tool call, that just adds a needless round trip.
>
> The name of this file is `CLAUDE.local.md`, and it is not the same file as
> a bare `CLAUDE.md`. Where these rules mention `CLAUDE.md` or `AGENTS.md`
> without the `.local` part, they mean the project's own tracked file, which
> is shared with everyone who clones. Call this one by its full name when you
> refer to it, and never write to `CLAUDE.md` meaning this file.

@AGENTS.local.md
@MEMORY.local.md

## Claude-Code-specific instructions

These supersede AGENTS.local.md instructions.

When updating agent rules, select the appropriate destination:

For anything truly Claude-Code-specific:
* If the instructions are specific to the agentcubicle container context: `.agentcubicle/CLAUDE.local.md`.
* If not:
  * If a git-tracked `CLAUDE.md` exists at the project level (the project's
    own shared file, not this one), ask the user where to put the instructions.
  * Else `.agentcubicle/CLAUDE.local.md`.

For anything not Claude-Code-specific, follow AGENTS.local.md's own instructions on
this matter (same rules, with AGENTS.local.md as the target instead).

## Where your own config and state live in this container

`CLAUDE_CONFIG_DIR` points at `.agentcubicle/claude-home/` inside the
project, not at the usual `~/.claude`. That directory holds `settings.json`,
`.claude.json`, `projects/` (per-project memory, transcripts), `sessions/`,
`plans/` and the rest of your state, and it persists across container
rebuilds because it sits in the project mount. When the user says "my
settings", that is the file to read or edit. Check `$CLAUDE_CONFIG_DIR`
rather than assuming a path.

If the host has a `settings.json`, it is mounted read-only (under
`/root/.claude/` or `/home/user/.config-host/claude/`, depending on the
container engine). That copy is only the source for a one-time seed; it is
not the live file, and it is not writable.

The seed happens once, the first time the container is created. After that
the copy in `claude-home/` wins, so changes made on the host do not reach an
already-seeded container, and changes made in a session stay in that
container. To pull in fresh host settings, the user deletes
`.agentcubicle/claude-home/settings.json` and runs again.

One exception: a short allowlist of keys (`CLAUDE_PROPAGATE_KEYS` in the
agentcubicle script, currently just `statusLine`) is re-read from the host
file and overwritten in `claude-home/settings.json` on every run, so those
keys always match the host and editing them in-container does not stick.

None of this is the project's own `.claude/` directory (`CLAUDE.md`,
`.claude/settings.json`, `.claude/agents/`, `.claude/skills/`), which is
tracked in git and shared with everyone who clones. Editing one when the
user meant the other is the mistake to avoid: `claude-home/` is per-machine
state, `.claude/` is project configuration. Ask if it is ambiguous.

(No project-specific Claude Code instructions yet — add any above as they
come up.)
CLAUDE_EOF
)
_seed_if_absent "$WORKDIR/.agentcubicle/CLAUDE.local.md" "$CLAUDE_CONTENT"
# CLAUDE.local.md is a relative symlink so Claude Code picks it up
# automatically every session (matches CLAUDE.md's own documented symlink
# convention). The -L check guards against a previously-created dangling
# symlink making `ln -s` fail outright.
if [[ ! -e "$WORKDIR/CLAUDE.local.md" && ! -L "$WORKDIR/CLAUDE.local.md" ]]; then
  ln -s .agentcubicle/CLAUDE.local.md "$WORKDIR/CLAUDE.local.md"
fi

# Register the persistent Claude state directory and the local files above
# in the repo's local, never-committed git-exclude file — NOT .gitignore,
# which is tracked and would leak which tool/container setup this repo uses
# to anyone who clones it. Applies regardless of which tool is running.
# No-op if the project isn't a git repo. Resolved via --git-common-dir
# (rather than checking `-d "$WORKDIR/.git"`) so this also works inside a
# git worktree or submodule, where `.git` is a file pointing elsewhere, not
# a directory. Guarded by --show-toplevel so this only fires when $WORKDIR
# is itself a repo/worktree root — otherwise --git-common-dir would walk up
# and find an unrelated parent repo when $WORKDIR is a plain subdirectory
# with no .git of its own, and register the exclude entries against the
# wrong root.
GIT_TOPLEVEL="$(git -C "$WORKDIR" rev-parse --show-toplevel 2>/dev/null || true)"
if [[ -n "$GIT_TOPLEVEL" ]] && [[ "$GIT_TOPLEVEL" -ef "$WORKDIR" ]]; then
  GIT_COMMON_DIR="$(git -C "$WORKDIR" rev-parse --git-common-dir)"
  case "$GIT_COMMON_DIR" in
    /*) : ;;
    *) GIT_COMMON_DIR="$WORKDIR/$GIT_COMMON_DIR" ;;
  esac
  EXCLUDE_FILE="$GIT_COMMON_DIR/info/exclude"
  mkdir -p "$(dirname "$EXCLUDE_FILE")"
  for entry in '/.agentcubicle/' '/CLAUDE.local.md'; do
    if ! grep -qxF "$entry" "$EXCLUDE_FILE" 2>/dev/null; then
      printf '%s\n' "$entry" >> "$EXCLUDE_FILE"
    fi
  done
fi

# Auto-detect clipboard/display backend and mount appropriate socket
if [[ -n "${WAYLAND_DISPLAY:-}" && -n "${XDG_RUNTIME_DIR:-}" && -S "$XDG_RUNTIME_DIR/$WAYLAND_DISPLAY" ]]; then
  if [[ "$ENGINE" == podman ]]; then
    # Rootless podman runs as a user whose UID need not match the host, so the
    # host /run/user/<uid> path is not reusable inside (Wayland rejects an
    # XDG_RUNTIME_DIR it thinks another user owns). Stage the socket under a
    # container-local runtime dir and point XDG_RUNTIME_DIR at that.
    EXTRA_MOUNTS+=("-v" "$XDG_RUNTIME_DIR/$WAYLAND_DISPLAY:/tmp/xdg-runtime/$WAYLAND_DISPLAY")
    EXTRA_ENVS+=("-e" "WAYLAND_DISPLAY=$WAYLAND_DISPLAY" "-e" "XDG_RUNTIME_DIR=/tmp/xdg-runtime")
  else
    EXTRA_MOUNTS+=("-v" "$XDG_RUNTIME_DIR/$WAYLAND_DISPLAY:$XDG_RUNTIME_DIR/$WAYLAND_DISPLAY")
    EXTRA_ENVS+=("-e" "WAYLAND_DISPLAY=$WAYLAND_DISPLAY" "-e" "XDG_RUNTIME_DIR=$XDG_RUNTIME_DIR")
  fi
elif [[ -n "${DISPLAY:-}" ]]; then
  EXTRA_MOUNTS+=("-v" "/tmp/.X11-unix:/tmp/.X11-unix")
  if [[ -n "${XAUTHORITY:-}" && -f "$XAUTHORITY" ]]; then
    EXTRA_MOUNTS+=("-v" "$XAUTHORITY:/home/user/.Xauthority")
    EXTRA_ENVS+=("-e" "XAUTHORITY=/home/user/.Xauthority")
  fi
  EXTRA_ENVS+=("-e" "DISPLAY=$DISPLAY")
fi

# Auto-forward a static Claude Code OAuth token (from `claude setup-token`) so
# `agentcubicle claude` just works with no flags, once set up once. Only
# for the claude tool, and only if the caller hasn't already set it via --env.
if [[ "$TOOL" == "claude" ]]; then
  HAS_EXPLICIT_TOKEN=false
  for env_entry in "${EXTRA_ENVS[@]+"${EXTRA_ENVS[@]}"}"; do
    if [[ "$env_entry" == CLAUDE_CODE_OAUTH_TOKEN=* ]]; then
      HAS_EXPLICIT_TOKEN=true
      break
    fi
  done

  # With --account, only that account's token file counts: a token exported
  # in the host shell (most likely the default account's) must not silently
  # win over an account the user explicitly named.
  if ! $HAS_EXPLICIT_TOKEN; then
    if [[ -z "$ACCOUNT" && -n "${CLAUDE_CODE_OAUTH_TOKEN:-}" ]]; then
      EXTRA_ENVS+=("-e" "CLAUDE_CODE_OAUTH_TOKEN=$CLAUDE_CODE_OAUTH_TOKEN")
    elif [[ -s "$CLAUDE_TOKEN_FILE" ]]; then
      EXTRA_ENVS+=("-e" "CLAUDE_CODE_OAUTH_TOKEN=$(cat "$CLAUDE_TOKEN_FILE")")
    fi
  fi

  # Whether claude will actually have something to authenticate with once
  # the container starts, after every detection path above has had a
  # chance to populate EXTRA_ENVS.
  CLAUDE_HAS_CREDENTIALS=false
  for env_entry in "${EXTRA_ENVS[@]+"${EXTRA_ENVS[@]}"}"; do
    if [[ "$env_entry" == CLAUDE_CODE_OAUTH_TOKEN=* || "$env_entry" == ANTHROPIC_API_KEY=* ]]; then
      CLAUDE_HAS_CREDENTIALS=true
      break
    fi
  done
fi

# The project is always mounted at the same container path, so a status line
# or script inside the container cannot tell projects apart by directory name
# (and a non-git project has no repo name either). Expose the host directory
# name, unless the caller set it explicitly via --env.
HAS_EXPLICIT_PROJECT_NAME=false
for env_entry in "${EXTRA_ENVS[@]+"${EXTRA_ENVS[@]}"}"; do
  if [[ "$env_entry" == AGENTCUBICLE_PROJECT_NAME || "$env_entry" == AGENTCUBICLE_PROJECT_NAME=* ]]; then
    HAS_EXPLICIT_PROJECT_NAME=true
    break
  fi
done
if ! $HAS_EXPLICIT_PROJECT_NAME; then
  EXTRA_ENVS+=("-e" "AGENTCUBICLE_PROJECT_NAME=$(basename "$WORKDIR")")
fi

if [[ -n "$HOST_GITCONFIG_B64" ]]; then
  EXTRA_ENVS+=("-e" "HOST_GITCONFIG_B64=$HOST_GITCONFIG_B64")
fi

if [[ -n "$OPENCODE_REDACTED_B64" ]]; then
  EXTRA_ENVS+=("-e" "OPENCODE_REDACTED_B64=$OPENCODE_REDACTED_B64" "-e" "OPENCODE_REDACTED_BASENAME=$OPENCODE_REDACTED_BASENAME")
fi

if [[ "$TOOL" == "claude" ]]; then
  EXTRA_ENVS+=("-e" "CLAUDE_PROPAGATE_B64=$CLAUDE_PROPAGATE_B64" "-e" "CLAUDE_SEED_STRIP_JQ=$CLAUDE_SEED_STRIP_JQ")
fi

# Build the inner command that runs as `user` (non-root).
# Base64-encode it to avoid nested quoting issues across shell boundaries.
#
# GIT_SETUP is shared by both tools: it decodes the forwarded host gitconfig
# (if any) straight to a file and points --global include.path at it, rather
# than reconstructing individual `git config` calls from arbitrary values —
# this is deliberate: arbitrary values re-parsed as shell text through the
# su -c reparse below is exactly the bug class fixed elsewhere in this script
# (see the single-quoting around OPENCODE_CONFIG_CONTENT).
GIT_SETUP='if [ -n "$HOST_GITCONFIG_B64" ]; then printf %s "$HOST_GITCONFIG_B64" | base64 -d > "$HOME/.gitconfig-forwarded" && git config --global include.path "$HOME/.gitconfig-forwarded"; fi; git config --global --add safe.directory '"$CONTAINER_PROJECT_DIR"'; '

# Claude Code updates itself in the background and then asks for a restart.
# Neither half works here: the container is removed when the tool exits, so
# the ~220MB it downloads into ~/.local/share/claude/versions/ is discarded,
# and claude runs via exec as a direct child of the entrypoint shell, so
# there is nothing to restart into. Without this the same download repeats
# every single session. DISABLE_AUTOUPDATER only stops the background check,
# so `claude update` still works inside a container for a one-off. The :-
# default is expanded by the inner shell, after su, so --env
# DISABLE_AUTOUPDATER=0 still wins on both engine paths.
CLAUDE_ENV_SETUP='export DISABLE_AUTOUPDATER=${DISABLE_AUTOUPDATER:-1}; '

# Sent as the tool's first turn so the "announce what you read" instruction
# in AGENTS.local.md/CLAUDE.local.md actually has a chance to fire: an interactive TUI
# never gives the model an unprompted turn, so without this the loaded
# instructions just sit there until the user happens to say something.
# Explicitly asks for a quick, non-deliberative first answer, scoped to
# just this one message - it does not touch any model/thinking settings,
# so nothing about later turns is affected.
# No apostrophes/quotes in this text — it survives through the same
# su -c reparse as everything else in INNER_CMD.
KICKOFF_PROMPT='Without spending extra time deliberating, briefly tell me which of your local instructions and memory files you have and give a quick one paragraph summary of what is in them, then stop and wait for what is next.'

# Names used in the claude token bootstrap messages, and the file through
# which the container hands a pasted token back to the host.
CLAUDE_TOKEN_DISPLAY="~/.claude/oauth-token${ACCOUNT:+-$ACCOUNT}"
CLAUDE_RUN_DISPLAY="agentcubicle claude${ACCOUNT:+ --account $ACCOUNT}"
CLAUDE_TOKEN_PENDING_REL=".agentcubicle/.oauth-token-pending"
CLAUDE_TOKEN_PENDING_IN_CONTAINER="$CONTAINER_PROJECT_DIR/$CLAUDE_TOKEN_PENDING_REL"

# --add-dir takes a variable number of directories and would swallow a
# positional argument right after it (the kickoff prompt, when no tool args
# are given), so it goes first, ended by --permission-mode. opencode needs no equivalent: the
# blanket "*": "allow" in OPENCODE_CONFIG_CONTENT comes after its built-in
# external_directory "ask" rule, and its permissions are last-match-wins.
CLAUDE_ADD_DIR_ARGS=""
if [[ -n "$CLAUDE_ADD_DIRS" ]]; then
  CLAUDE_ADD_DIR_ARGS="--add-dir$CLAUDE_ADD_DIRS "
fi

if [[ "$TOOL" == "opencode" ]]; then
  INNER_CMD="$GIT_SETUP export OPENCODE_CONFIG_CONTENT='$OPENCODE_CONFIG_JSON'; exec opencode --agent plan --prompt '$KICKOFF_PROMPT' \"\$@\""
elif $CLAUDE_HAS_CREDENTIALS; then
  INNER_CMD="$GIT_SETUP$CLAUDE_ENV_SETUP export CLAUDE_CONFIG_DIR=$CONTAINER_PROJECT_DIR/.agentcubicle/claude-home; exec claude $CLAUDE_ADD_DIR_ARGS--permission-mode plan \"\$@\" '$KICKOFF_PROMPT'"
else
  # No credentials detected on the host. Instead of starting a normal
  # session (which would just hit a login wall), run `claude setup-token`
  # right here, then ask the user to paste the printed token. The container
  # cannot write to ~/.claude on the host (it is never mounted), so the token
  # is handed over through a pending file in the project mount, which the
  # host side moves into place once the container exits (see
  # _save_pending_claude_token below). If nothing is pasted, fall back to the
  # manual save steps and an interactive shell to type them in.
  # No apostrophes/quotes in this text: it is embedded between single quotes
  # below and survives the same su -c reparse as KICKOFF_PROMPT.
  CLAUDE_BOOTSTRAP_INTRO_MSG=$(cat <<EOF
No Claude Code credentials were found for this container (no $CLAUDE_TOKEN_DISPLAY, no CLAUDE_CODE_OAUTH_TOKEN, no ANTHROPIC_API_KEY). Generating one now instead of starting a normal session.

claude setup-token will print a URL below. Open it in a browser, log into the Claude account you want to use, and authorize. The browser decides the account: use a private window if you are logged into another one. It will then print a token string right here in this terminal.
EOF
  )
  CLAUDE_BOOTSTRAP_PASTE_MSG=$(cat <<EOF

Paste the token printed above and press Enter (input is hidden):
EOF
  )
  CLAUDE_BOOTSTRAP_DONE_MSG=$(cat <<EOF
Token received. It is saved to $CLAUDE_TOKEN_DISPLAY on the host when this container exits, which it does now.
EOF
  )
  CLAUDE_BOOTSTRAP_MANUAL_MSG=$(cat <<EOF
No token pasted. To save it by hand, write it into the bind-mounted project directory so it survives this container exiting:
  echo <paste token here> > $CONTAINER_PROJECT_DIR/.claude-oauth-token

Then exit this container (exit or Ctrl-D). On the host, run:
  mkdir -p ~/.claude && mv .claude-oauth-token $CLAUDE_TOKEN_DISPLAY && chmod 600 $CLAUDE_TOKEN_DISPLAY

Then start a fresh container to confirm it worked: $CLAUDE_RUN_DISPLAY
EOF
  )
  INNER_CMD="$GIT_SETUP$CLAUDE_ENV_SETUP export CLAUDE_CONFIG_DIR=$CONTAINER_PROJECT_DIR/.agentcubicle/claude-home; echo '$CLAUDE_BOOTSTRAP_INTRO_MSG'; if ! claude setup-token; then echo 'Token setup did not finish. Run $CLAUDE_RUN_DISPLAY again to retry.'; exec sh; fi; echo '$CLAUDE_BOOTSTRAP_PASTE_MSG'; stty -echo 2>/dev/null; read -r tok; stty echo 2>/dev/null; echo; if [ -n \"\$tok\" ] && (umask 077; printf %s \"\$tok\" > $CLAUDE_TOKEN_PENDING_IN_CONTAINER); then echo '$CLAUDE_BOOTSTRAP_DONE_MSG'; else echo '$CLAUDE_BOOTSTRAP_MANUAL_MSG'; exec sh; fi"
fi

# Test hook: when AGENTCUBICLE_TEST_CMD is set, replace the interactive tool
# launch with that command so CI can drive the run path headlessly. Not a
# supported user-facing option.
if [[ -n "${AGENTCUBICLE_TEST_CMD:-}" ]]; then
  INNER_CMD="$AGENTCUBICLE_TEST_CMD"
fi
INNER_B64=$(printf '%s' "$INNER_CMD" | base64 -w0)

if [[ "$TOOL" == "claude" ]] && ! $CLAUDE_HAS_CREDENTIALS; then
  if [[ -n "$ACCOUNT" ]]; then
    echo "No Claude Code credentials detected for account '$ACCOUNT' (no $CLAUDE_TOKEN_DISPLAY)."
  else
    echo "No Claude Code credentials detected (no ~/.claude/oauth-token, no CLAUDE_CODE_OAUTH_TOKEN, no ANTHROPIC_API_KEY)."
  fi
  echo "Starting a container to generate one via 'claude setup-token' instead of a normal session."

  # Move a token pasted during the bootstrap into place on the host. Runs as
  # an EXIT trap so it also happens when the engine exits non-zero (set -e),
  # and leaves the exit status alone. The pending file never outlives the run.
  _save_pending_claude_token() {
    local pending="$WORKDIR/$CLAUDE_TOKEN_PENDING_REL"
    if [[ -s "$pending" ]]; then
      mkdir -p "$HOME/.claude"
      if mv "$pending" "$CLAUDE_TOKEN_FILE" && chmod 600 "$CLAUDE_TOKEN_FILE"; then
        echo "Saved the Claude token to $CLAUDE_TOKEN_DISPLAY. Start a session with: $CLAUDE_RUN_DISPLAY"
      else
        echo "Error: could not save the Claude token to $CLAUDE_TOKEN_DISPLAY." >&2
      fi
    fi
    rm -f "$pending"
  }
  rm -f "$WORKDIR/$CLAUDE_TOKEN_PENDING_REL"
  trap _save_pending_claude_token EXIT
fi

if [[ "$TOOL" == "opencode" ]] && ! $OPENCODE_HAS_PROVIDER; then
  echo "No providers configured in $CONFIG_HOME/opencode.json(c) — only opencode's built-in free models will be available."
  echo "To add a real provider: add a \"provider\" section to that file with an API key referenced as {env:YOUR_VAR}, then pass the actual value with --env YOUR_VAR=... when running agentcubicle opencode."
fi

echo "Starting container: ${CONTAINER_NAME}"

# Whether to allocate a TTY. Dropped in headless test mode (CI has no
# controlling terminal).
RUN_TTY_ARGS=(-it)
if [[ -n "${AGENTCUBICLE_TEST_CMD:-}" ]]; then
  RUN_TTY_ARGS=()
fi

# The container itself is throwaway: everything worth keeping is either in the
# project mount or in the image (via `commit`), so a container left behind after
# the tool exits only costs disk. Remove it on exit unless --keep-container was
# passed, which is what you need if you want to commit the container after
# exiting rather than while it runs.
RUN_RM_ARGS=(--rm)
if $KEEP_CONTAINER; then
  RUN_RM_ARGS=()
fi

if [[ "$ENGINE" == podman ]]; then
  # Rootless podman: --userns=keep-id maps the host user onto the image's baked
  # UID 1000, so we run as that user directly (no root remap phase) and files
  # written into bind mounts land owned by the host user. Config is staged
  # read-only under /home/user (see CONFIG_HOME_MOUNT_ARGS) and copied into
  # place by the entrypoint, since the unprivileged user cannot read /root.
  # No usermod/groupmod/chown: keep-id already gives files the right owner.
  $ENGINE run ${RUN_TTY_ARGS[@]+"${RUN_TTY_ARGS[@]}"} ${RUN_RM_ARGS[@]+"${RUN_RM_ARGS[@]}"} \
    --name "$CONTAINER_NAME" \
    --entrypoint sh \
    --userns=keep-id:uid=1000,gid=1000 \
    --security-opt label=disable \
    -w "$CONTAINER_PROJECT_DIR" \
    -v "$WORKDIR:$CONTAINER_PROJECT_DIR:rw" \
    ${CONFIG_HOME_MOUNT_ARGS[@]+"${CONFIG_HOME_MOUNT_ARGS[@]}"} \
    ${EXTRA_MOUNTS[@]+"${EXTRA_MOUNTS[@]}"} \
    -e HOME=/home/user \
    -e "INNER_B64=$INNER_B64" \
    -e "TOOL=$TOOL" \
    ${EXTRA_ENVS[@]+"${EXTRA_ENVS[@]}"} \
    "$IMAGE" \
    -c \
    'mkdir -p /home/user/.config/opencode
     if [ -n "$OPENCODE_REDACTED_B64" ]; then
       printf %s "$OPENCODE_REDACTED_B64" | base64 -d > "/home/user/.config/opencode/$OPENCODE_REDACTED_BASENAME"
     elif [ -f /home/user/.config-host/opencode/opencode.json ]; then
       cp /home/user/.config-host/opencode/opencode.json /home/user/.config/opencode/
     elif [ -f /home/user/.config-host/opencode/opencode.jsonc ]; then
       cp /home/user/.config-host/opencode/opencode.jsonc /home/user/.config/opencode/
     fi
     if [ "$TOOL" = "claude" ]; then
       CLAUDE_STATE_DIR=/home/user/project/.agentcubicle/claude-home
       mkdir -p "$CLAUDE_STATE_DIR"
       [ -n "$CLAUDE_SEED_STRIP_JQ" ] || CLAUDE_SEED_STRIP_JQ="."
       if [ ! -f "$CLAUDE_STATE_DIR/settings.json" ]; then
         if [ -f /home/user/.config-host/claude/settings.json ]; then
           jq "$CLAUDE_SEED_STRIP_JQ" /home/user/.config-host/claude/settings.json > "$CLAUDE_STATE_DIR/settings.json" \
             || cp /home/user/.config-host/claude/settings.json "$CLAUDE_STATE_DIR/settings.json"
         else
           echo "{}" > "$CLAUDE_STATE_DIR/settings.json"
         fi
       fi
       if [ -n "$CLAUDE_PROPAGATE_B64" ]; then
         printf %s "$CLAUDE_PROPAGATE_B64" | base64 -d > "$CLAUDE_STATE_DIR/.settings-propagate.json"
       else
         echo "{}" > "$CLAUDE_STATE_DIR/.settings-propagate.json"
       fi
       jq -s ".[0] + {skipDangerousModePermissionPrompt: true} + .[1]" \
         "$CLAUDE_STATE_DIR/settings.json" "$CLAUDE_STATE_DIR/.settings-propagate.json" > "$CLAUDE_STATE_DIR/settings.json.tmp" \
         && mv "$CLAUDE_STATE_DIR/settings.json.tmp" "$CLAUDE_STATE_DIR/settings.json"
       rm -f "$CLAUDE_STATE_DIR/.settings-propagate.json"
       echo "{\"hasCompletedOnboarding\": true, \"projects\": {\"/home/user/project\": {\"hasTrustDialogAccepted\": true}}}" > "$CLAUDE_STATE_DIR/.claude.json"
     fi
     CMD=$(echo "$INNER_B64" | base64 -d)
     exec sh -c "export PATH=\"/home/user/.local/bin:\$PATH\"; $CMD" _ "$@"' \
    _ ${EXTRA_ARGS[@]+"${EXTRA_ARGS[@]}"}
else
# Container starts as root → remaps `user` UID/GID to host → su's to user.
$ENGINE run ${RUN_TTY_ARGS[@]+"${RUN_TTY_ARGS[@]}"} ${RUN_RM_ARGS[@]+"${RUN_RM_ARGS[@]}"} \
  --name "$CONTAINER_NAME" \
  --entrypoint sh \
  -w "$CONTAINER_PROJECT_DIR" \
  -v "$WORKDIR:$CONTAINER_PROJECT_DIR:rw" \
  ${CONFIG_HOME_MOUNT_ARGS[@]+"${CONFIG_HOME_MOUNT_ARGS[@]}"} \
  ${EXTRA_MOUNTS[@]+"${EXTRA_MOUNTS[@]}"} \
  -e HOME=/root \
  -e "HOST_UID=$(id -u)" \
  -e "HOST_GID=$(id -g)" \
  -e "INNER_B64=$INNER_B64" \
  -e "TOOL=$TOOL" \
  ${EXTRA_ENVS[@]+"${EXTRA_ENVS[@]}"} \
  "$IMAGE" \
  -c \
  'groupmod -g $HOST_GID user
   usermod -u $HOST_UID user
   mkdir -p /home/user/.config/opencode
   if [ -n "$OPENCODE_REDACTED_B64" ]; then
     printf %s "$OPENCODE_REDACTED_B64" | base64 -d > "/home/user/.config/opencode/$OPENCODE_REDACTED_BASENAME"
   elif [ -f /root/.config/opencode/opencode.json ]; then
     cp /root/.config/opencode/opencode.json /home/user/.config/opencode/
   elif [ -f /root/.config/opencode/opencode.jsonc ]; then
     cp /root/.config/opencode/opencode.jsonc /home/user/.config/opencode/
   fi
   if [ "$TOOL" = "claude" ]; then
     CLAUDE_STATE_DIR=/home/user/project/.agentcubicle/claude-home
     mkdir -p "$CLAUDE_STATE_DIR"
     # Seed from the host settings.json only once. CLAUDE_STATE_DIR now
     # persists across container recreations (unlike the throwaway HOME
     # this used to live in), so unconditionally re-copying here would
     # clobber any settings changes accumulated in a previous session.
     # CLAUDE_SEED_STRIP_JQ drops the keys the host side refused to
     # propagate, so they do not arrive through the seed either.
     [ -n "$CLAUDE_SEED_STRIP_JQ" ] || CLAUDE_SEED_STRIP_JQ="."
     if [ ! -f "$CLAUDE_STATE_DIR/settings.json" ]; then
       if [ -f /root/.claude/settings.json ]; then
         jq "$CLAUDE_SEED_STRIP_JQ" /root/.claude/settings.json > "$CLAUDE_STATE_DIR/settings.json" \
           || cp /root/.claude/settings.json "$CLAUDE_STATE_DIR/settings.json"
       else
         echo "{}" > "$CLAUDE_STATE_DIR/settings.json"
       fi
     fi
     # The always-propagated keys (CLAUDE_PROPAGATE_B64, built and validated
     # on the host) are merged last, so they win over both the persisted copy
     # and anything written in-container.
     if [ -n "$CLAUDE_PROPAGATE_B64" ]; then
       printf %s "$CLAUDE_PROPAGATE_B64" | base64 -d > "$CLAUDE_STATE_DIR/.settings-propagate.json"
     else
       echo "{}" > "$CLAUDE_STATE_DIR/.settings-propagate.json"
     fi
     jq -s ".[0] + {skipDangerousModePermissionPrompt: true} + .[1]" \
       "$CLAUDE_STATE_DIR/settings.json" "$CLAUDE_STATE_DIR/.settings-propagate.json" > "$CLAUDE_STATE_DIR/settings.json.tmp" \
       && mv "$CLAUDE_STATE_DIR/settings.json.tmp" "$CLAUDE_STATE_DIR/settings.json"
     rm -f "$CLAUDE_STATE_DIR/.settings-propagate.json"
     # Claude Code resolves its onboarding/trust-dialog state file relative
     # to CLAUDE_CONFIG_DIR when that env var is set (confirmed by reading
     # the actual binary config-path resolver directly), not at
     # $HOME/.claude.json, so the stub has to live inside CLAUDE_STATE_DIR
     # (which is what CLAUDE_CONFIG_DIR points at below), or the onboarding
     # wizard shows up every run despite this file existing at the old,
     # wrong location.
     echo "{\"hasCompletedOnboarding\": true, \"projects\": {\"/home/user/project\": {\"hasTrustDialogAccepted\": true}}}" > "$CLAUDE_STATE_DIR/.claude.json"
     # claude-home lives inside the project mount, which the chown -R below
     # deliberately skips (see docs/DESIGN.md). The root-phase mkdir/seeds
     # above therefore leave it root:root, and the unprivileged user we
     # drop to would hit EACCES. Chown it back explicitly here
     # (unconditional, so a dir left
     # root-owned by an older buggy run self-heals on the next run).
     chown -R $HOST_UID:$HOST_GID "$CLAUDE_STATE_DIR"
   fi
   chown $HOST_UID:$HOST_GID /home/user
   # Skip project (the project bind mount) and .Xauthority (a host file
   # mounted read-write for X11 forwarding): both already carry the host
   # UID/GID on disk, so recursing into them would only waste time and
   # needlessly touch every inode of the actual project tree.
   find /home/user -mindepth 1 -maxdepth 1 ! -name project ! -name .Xauthority -exec chown -R $HOST_UID:$HOST_GID {} +
    export HOME=/home/user
    CMD=$(echo "$INNER_B64" | base64 -d)
    # su is BusyBox on musl, whose option parser keeps going after the user
    # name: without the --, tool args such as --help or claude -c would be
    # taken as su options.
    exec su -s /bin/sh -c "export PATH=\"/home/user/.local/bin:\$PATH\"; $CMD" -- user _ "$@"' \
  _ ${EXTRA_ARGS[@]+"${EXTRA_ARGS[@]}"}
fi


